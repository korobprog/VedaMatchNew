// ===== Vedabase canonical content =====

/// Что за книга. От этого зависит, можно ли добывать из неё цитаты: в
/// биографии повествование ведёт биограф, и его слова нельзя приписывать
/// герою книги, который значится в поле `author`.
enum VedabaseBookKind {
  scripture
  teaching
  biography
  other
}

model VedabaseBook {
  id              String                @id @default(uuid())
  slug            String                @unique
  title           String
  author          String?
  kind            VedabaseBookKind      @default(teaching)
  language        String
  cover           Json?
  sourceUrl       String
  attribution     String
  activeVersionId String?               @unique
  activeVersion   VedabaseBookVersion?  @relation("ActiveVedabaseVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions        VedabaseBookVersion[] @relation("VedabaseBookVersions")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model VedabaseBookVersion {
  id                  String               @id @default(uuid())
  bookId              String
  book                VedabaseBook         @relation("VedabaseBookVersions", fields: [bookId], references: [id], onDelete: Cascade)
  activeFor           VedabaseBook?        @relation("ActiveVedabaseVersion")
  contentVersion      String
  formatVersion       Int
  status              VedabaseImportStatus @default(staging)
  permissionRef       String
  attribution         String
  importedAt          DateTime
  sizeBytes           BigInt
  packageChecksum     String
  chapterCount        Int
  searchableUnitCount Int
  searchIndexBytes    Int
  searchIndexSha256   String
  coverBytes          Int?
  coverSha256         String?
  errorMessage        String?
  chapters            VedabaseChapter[]
  searchUnits         VedabaseSearchUnit[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([bookId, contentVersion])
  @@index([status, updatedAt])
}

model VedabaseChapter {
  id        String              @id @default(uuid())
  versionId String
  version   VedabaseBookVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  order     Int
  payload   Json
  bytes     Int
  sha256    String

  @@unique([versionId, slug])
  @@unique([versionId, order])
}

model VedabaseSearchUnit {
  id          String              @id @default(uuid())
  versionId   String
  version     VedabaseBookVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  chapterSlug String
  locator     Json
  title       String
  text        String

  @@index([versionId, chapterSlug])
}

// ===== Union service =====
// Модели сервиса VedaMatch Union. Связи только с User (read-only портальные данные).
// См. docs/service-module-contract.md

enum UnionIntentionType {
  family
  business
  friendship
  service
}

enum UnionConnectionStatus {
  pending
  accepted
  declined
  cancelled
}

enum UnionFormat {
  online
  offline
  any
}

/// Питание. Для вайшнавского контекста заменяет вопросы «алкоголь/курение» из массовых анкет.
enum UnionDiet {
  vegetarian
  vegan
  prasadam_only
  transitioning
  not_vegetarian
}

/// Четыре регулирующих принципа. Хранятся как набор соблюдаемых — «ничего не выбрано»
/// означает «не указано», а не «не соблюдаю ничего».
enum UnionRegulativePrinciple {
  no_meat
  no_intoxicants
  no_gambling
  no_illicit_sex
}

enum UnionChildrenStatus {
  none_want
  none_not_want
  none_undecided
  have_living_with
  have_living_apart
}

enum UnionEducationLevel {
  school
  vocational
  incomplete_higher
  higher
  academic_degree
}

enum UnionSpiritualEducation {
  none
  temple_courses
  bhakti_shastri
  bhakti_vaibhava
  bhakti_vedanta
  other
}

enum UnionHousing {
  own_place
  rent
  with_parents
  with_relatives
  community
  temple_ashram
}

/// Материальная обеспеченность. Формулировки намеренно мягкие, поле опционально
/// и закрывается настройками приватности.
enum UnionIncomeLevel {
  basic_needs_hard
  basic_needs
  basic_and_rest
  comfortable
  prefer_not_say
}

model UnionProfile {
  id                       String                     @id @default(uuid())
  userId                   String                     @unique
  user                     User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  about                    String?
  /// Короткая строка-статус поверх анкеты
  status                   String?
  relocationReady          Boolean                    @default(false)
  format                   UnionFormat                @default(any)
  languages                String[]                   @default([])
  skills                   String[]                   @default([])
  interests                String[]                   @default([])
  values                   String[]                   @default([])
  familyStatus             String?
  // Блок «О себе»: все поля опциональны
  heightCm                 Int?
  diet                     UnionDiet?
  regulativePrinciples     UnionRegulativePrinciple[] @default([])
  childrenStatus           UnionChildrenStatus?
  education                UnionEducationLevel?
  spiritualEducation       UnionSpiritualEducation?
  housing                  UnionHousing?
  income                   UnionIncomeLevel?
  pets                     String[]                   @default([])
  // Желаемый возраст партнёра; используется как фильтр рекомендаций
  ageRangeMin              Int?
  ageRangeMax              Int?
  // { photo, age, city, contacts: 'everyone' | 'after_match' | 'hidden' }
  privacy                  Json?
  // скрыть из рекомендаций без удаления профиля
  isActive                 Boolean                    @default(true)
  // принимать запросы на знакомство только от подтверждённых преданных
  requestsFromVerifiedOnly Boolean                    @default(false)
  /// Кто может начать общение: заявки от всех или только взаимные лайки
  contactMode              UnionContactMode           @default(requests)
  /// Кого искать при цели «Создание семьи». null — пол не важен. Работает
  /// в обе стороны и только пока цель «Создание семьи» отмечена.
  familySeeksGender        Gender?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  intentions UnionIntention[]

  @@index([isActive])
}

/// Режим знакомства. `requests` — односторонний лайк приходит как заявка,
/// человек отвечает вручную. `mutual_only` — заявка создаётся только когда
/// лайк взаимный, односторонние интересующиеся не показываются.
enum UnionContactMode {
  requests
  mutual_only
}

enum UnionSwipeDecision {
  like
  superlike
  pass
}

/// Буст «Внимание»: пока не истёк, анкета идёт первой в чужих рекомендациях.
model UnionBoost {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UnionBoosts", fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

/// Решение по анкете в колоде. Хранится, чтобы пропущенные не возвращались
/// в выдачу и чтобы работал откат последнего свайпа.
model UnionSwipe {
  id         String             @id @default(uuid())
  fromUserId String
  fromUser   User               @relation("UnionSwipesMade", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User               @relation("UnionSwipesReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  decision   UnionSwipeDecision
  createdAt  DateTime           @default(now())
  /// Момент отката. Откатанный свайп не влияет на выдачу.
  undoneAt   DateTime?

  @@unique([fromUserId, toUserId])
  @@index([toUserId, decision])
  @@index([fromUserId, undoneAt, createdAt])
}

model UnionIntention {
  id        String             @id @default(uuid())
  profileId String
  profile   UnionProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type      UnionIntentionType
  // 0..100, сумма по профилю = 100 (валидируется в сервисе)
  weight    Int

  @@unique([profileId, type])
}

model UnionConnectionRequest {
  id          String                @id @default(uuid())
  fromUserId  String
  fromUser    User                  @relation("UnionRequestsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User                  @relation("UnionRequestsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  status      UnionConnectionStatus @default(pending)
  /// Заявка отправлена суперлайком: поднимается в списке входящих.
  isSuperlike Boolean               @default(false)
  message     String?
  createdAt   DateTime              @default(now())
  respondedAt DateTime?

  messages UnionChatMessage[]

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
}

enum UserReportReason {
  spam
  harassment
  fake_profile
  inappropriate_content
  offline_safety
  other
}

enum UserReportStatus {
  open
  reviewed
  dismissed
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("UserBlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// Где действует скрытие. Отдельный сервис спрашивает свой скоуп и `all`.
enum UserHideScope {
  all
  union
  contacts
}

/// Откуда взялась запись. `manual` — человек сам убрал кого-то из своей выдачи,
/// `union_declined` — автоматика отказа по заявке знакомства.
enum UserHideSource {
  manual
  union_declined
  moderation
}

/// Односторонняя невидимость: `ownerId` не показывается `viewerId`.
/// В отличие от `UserBlock` работает в одну сторону и заводится автоматикой:
/// отказ по заявке в Union прячет отказавшего от того, кому отказали, во всех
/// сервисах-справочниках. Обратное направление не создаётся — отказавший
/// может передумать и найти человека сам.
model UserHiddenFrom {
  id        String         @id @default(uuid())
  /// Кого скрываем.
  ownerId   String
  owner     User           @relation("UserHiddenOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// От кого скрываем.
  viewerId  String
  viewer    User           @relation("UserHiddenViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  scope     UserHideScope  @default(all)
  source    UserHideSource
  createdAt DateTime       @default(now())
  /// Срок, после которого скрытие перестаёт действовать. null — бессрочно.
  expiresAt DateTime?

  @@unique([ownerId, viewerId, scope])
  @@index([viewerId, scope, expiresAt])
}

model UserReport {
  id            String           @id @default(uuid())
  reporterId    String
  reporter      User             @relation("UserReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  targetId      String
  target        User             @relation("UserReportsReceived", fields: [targetId], references: [id], onDelete: Cascade)
  reason        UserReportReason
  comment       String?
  status        UserReportStatus @default(open)
  createdAt     DateTime         @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?            @relation("UserReportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  moderatorNote String?

  @@index([status, createdAt])
  @@index([targetId])
}

/// Обращение в поддержку. userId пуст у гостевых тикетов с лендинга — связь
/// с автором держится на contactEmail/contactTelegram и trackToken.
model SupportTicket {
  id              String                @id @default(uuid())
  number          Int                   @unique @default(autoincrement())
  /// Секретная ссылка для гостя: единственный способ посмотреть свой тикет без входа.
  trackToken      String                @unique
  userId          String?
  user            User?                 @relation("SupportTicketsOwned", fields: [userId], references: [id], onDelete: SetNull)
  contactName     String?
  contactEmail    String?
  contactTelegram String?
  subject         String
  category        SupportTicketCategory @default(other)
  status          SupportTicketStatus   @default(open)
  assignedToId    String?
  assignedTo      User?                 @relation("SupportTicketsAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  adminNote       String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  firstResponseAt DateTime?
  closedAt        DateTime?
  lastMessageAt   DateTime              @default(now())

  messages SupportTicketMessage[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model SupportTicketMessage {
  id           String              @id @default(uuid())
  ticketId     String
  ticket       SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType   SupportTicketAuthor
  authorUserId String?
  authorUser   User?               @relation("SupportTicketMessagesAuthored", fields: [authorUserId], references: [id], onDelete: SetNull)
  body         String
  /// Внутренняя заметка видна только администраторам.
  isInternal   Boolean             @default(false)
  createdAt    DateTime            @default(now())

  @@index([ticketId, createdAt])
}

model UnionChatMessage {
  id         String                 @id @default(uuid())
  requestId  String
  request    UnionConnectionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User                   @relation("UnionChatMessagesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  body       String
  /// Когда собеседник прочитал сообщение; null — ещё не прочитано.
  readAt     DateTime?
  /// Когда сообщение было отредактировано; null — не редактировалось.
  editedAt   DateTime?
  createdAt  DateTime               @default(now())
  reactions  UnionMessageReaction[]

  @@index([requestId, createdAt])
  @@index([fromUserId])
  @@index([requestId, readAt])
}

/// Реакция на сообщение чата. Одна реакция на пользователя на сообщение —
/// повторный выбор того же эмодзи снимает реакцию, другого — заменяет.
model UnionMessageReaction {
  id        String           @id @default(uuid())
  messageId String
  message   UnionChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation("UnionMessageReactionsMade", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime         @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

// ===== Library service =====

enum LibraryEntryType {
  website
  article
  video
  audio
  book
  course
  app
  telegram_channel
  community
  other
}

enum LibraryEntryStatus {
  published
  hidden_by_reports
  removed_by_admin
}

enum LibraryEnrichmentStatus {
  pending
  queued
  ready
  failed
}

enum LibraryCategoryStatus {
  active
  hidden_by_reports
  merged
  removed
}

model LibrarySection {
  id            String   @id @default(uuid())
  slug          String   @unique
  titleRu       String
  titleEn       String
  descriptionRu String?
  descriptionEn String?
  iconKey       String?
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categories LibraryCategory[]

  @@index([position])
}

model LibraryCategory {
  id               String                @id @default(uuid())
  sectionId        String
  section          LibrarySection        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  slug             String
  titleRu          String?
  titleEn          String?
  descriptionRu    String?
  descriptionEn    String?
  normalizedRu     String                @default("")
  normalizedEn     String                @default("")
  createdById      String?
  createdBy        User?                 @relation("LibraryCategoryAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  status           LibraryCategoryStatus @default(active)
  mergedIntoId     String?
  mergedInto       LibraryCategory?      @relation("LibraryCategoryMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom       LibraryCategory[]     @relation("LibraryCategoryMerge")
  entriesCount     Int                   @default(0)
  followersCount   Int                   @default(0)
  openReportsCount Int                   @default(0)
  needsReview      Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  entries LibraryEntryCategory[]

  @@unique([sectionId, slug])
  @@index([sectionId, status])
  @@index([status, entriesCount])
}

model LibraryEntry {
  id               String                   @id @default(uuid())
  url              String
  urlNormalized    String                   @unique
  canonicalUrl     String?
  domain           String
  type             LibraryEntryType
  contentLanguage  String                   @default("ru") @db.VarChar(8)
  titleRu          String?
  titleEn          String?
  descriptionRu    String?
  descriptionEn    String?
  ogTitle          String?
  ogDescription    String?
  ogSiteName       String?
  faviconUrl       String?
  previewKey       String?
  previewUrl       String?
  /// `true` — обложку загрузил автор/админ вручную; авто-обновление обложки такую запись не трогает.
  previewIsCustom  Boolean                  @default(false)
  enrichmentStatus LibraryEnrichmentStatus  @default(pending)
  enrichmentError  String?
  enrichedAt       DateTime?
  httpStatus       Int?
  lastCheckedAt    DateTime?
  addedById        String?
  addedBy          User?                    @relation("LibraryEntryAuthor", fields: [addedById], references: [id], onDelete: SetNull)
  status           LibraryEntryStatus       @default(published)
  needsReview      Boolean                  @default(false)
  usefulCount      Int                      @default(0)
  notUsefulCount   Int                      @default(0)
  uniqueClickCount Int                      @default(0)
  bookmarkCount    Int                      @default(0)
  commentsCount    Int                      @default(0)
  openReportsCount Int                      @default(0)
  rankScore        Float                    @default(0)
  /// Generated column, создаётся SQL-миграцией. Prisma её не пишет.
  searchVector     Unsupported("tsvector")?
  publishedAt      DateTime                 @default(now())
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  categories LibraryEntryCategory[]
  bookmarks  LibraryBookmark[]
  comments   LibraryComment[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([status, rankScore(sort: Desc)])
  @@index([type])
  @@index([contentLanguage])
  @@index([domain])
  @@index([addedById])
}

model LibraryEntryCategory {
  entryId    String
  entry      LibraryEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  categoryId String
  category   LibraryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  addedById  String?
  createdAt  DateTime        @default(now())

  @@id([entryId, categoryId])
  @@index([categoryId])
}

/// Избранное: у пары «пользователь + ссылка» запись одна, счётчик на
/// LibraryEntry.bookmarkCount держим денормализованным для ленты.
model LibraryBookmark {
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryId   String
  entry     LibraryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@id([userId, entryId])
  @@index([entryId])
  @@index([userId, createdAt(sort: Desc)])
}

enum LibraryCommentStatus {
  published
  removed_by_author
  removed_by_admin
}

/// Комментарии под ссылкой. Плоские: ветки в библиотеке ссылок избыточны,
/// а удалённые оставляем строкой со статусом, чтобы не рвать нумерацию.
model LibraryComment {
  id        String               @id @default(uuid())
  entryId   String
  entry     LibraryEntry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  body      String
  status    LibraryCommentStatus @default(published)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([entryId, createdAt])
  @@index([userId])
}

model LibraryPreference {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  uiLanguage       String   @default("ru") @db.VarChar(8)
  contentLanguages String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ===== Notifications (портальная инфраструктура) =====

/// Подписка браузера на веб-пуши. У одного пользователя их несколько:
/// телефон, ноутбук, планшет. Ключ подписки — endpoint, его выдаёт браузер.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Настройки уведомлений. Отсутствие строки означает «включено всё»,
/// поэтому при регистрации её создавать не нужно.
model NotificationPreference {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(true)
  chat        Boolean  @default(true)
  connections Boolean  @default(true)
  support     Boolean  @default(true)
  /// Ежедневный персональный день по транзитам (сервис astro).
  transits    Boolean  @default(true)
  /// Заявки и их статусы на Рынке. Сообщения чата Рынка идут под `chat`.
  market      Boolean  @default(true)
  /// Доска «Объявления»: подписки на рубрику и город, отклики на свои
  /// объявления. Своя колонка, а не переиспользование `market`: выключив
  /// коммерцию, человек не должен молча терять доску общины.
  notices     Boolean  @default(true)
  /// Объявления администрации портала (рассылки). Выключение гасит пуш; в
  /// колокольчик важная рассылка приходит всё равно — см.
  /// NotificationBroadcast.important.
  system      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

/// Входящие уведомления портала (колокольчик). Намеренно НЕ архив: прочитанное
/// удаляется при следующем открытии списка, см. NotificationsService.listInbox.
/// Живёт отдельно от веб-пуша: колокольчик работает и без разрешения браузера.
model NotificationItem {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  /// Куда ведёт клик по уведомлению — тот же путь, что и у пуша.
  url       String
  /// Категория из NotificationPreference: chat | connections | support | transits.
  category  String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Статус рассылки. Отправка идёт пакетами в фоне, поэтому `sending` — не миг,
/// а состояние, из которого воркер выходит сам.
enum NotificationBroadcastStatus {
  draft
  sending
  sent
  failed
  cancelled
}

/// Объявление администрации всем или части портала. Хранится целиком: после
/// отправки нужно знать, что именно ушло и скольким.
model NotificationBroadcast {
  id          String                      @id @default(uuid())
  title       String
  body        String
  /// Куда ведёт клик. Пусто — уведомление без перехода.
  url         String?
  /// Важное: попадает в колокольчик даже при выключенной категории `system`.
  /// Пуш при этом всё равно уважает настройки — устройство человека не наше.
  important   Boolean                     @default(false)
  /// Фильтр аудитории (NotificationAudienceFilter). Json, а не колонки: набор
  /// фильтров будет меняться чаще, чем стоит гонять миграции.
  audience    Json
  status      NotificationBroadcastStatus @default(draft)
  /// Сколько получателей насчитал фильтр в момент запуска.
  totalRecipients Int                     @default(0)
  /// Сколько уведомлений положено в колокольчик.
  deliveredCount  Int                     @default(0)
  /// Сколько пушей ушло на устройства. Меньше deliveredCount — это норма.
  pushSentCount   Int                     @default(0)
  /// Курсор пакетной отправки: id последнего обработанного пользователя.
  /// Сортировка по id — единственный способ не пропустить и не задвоить.
  cursorUserId    String?
  attemptCount    Int                     @default(0)
  errorMessage    String?
  createdById String?
  createdBy   User?                       @relation("NotificationBroadcastsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([status, updatedAt])
  @@index([createdAt(sort: Desc)])
}

// ===== Astro service =====

/// Насколько точно известно время рождения. `unknown` — карта считается на полдень,
/// а лагна и дома не показываются: асцендент по выдуманному времени хуже, чем его
/// отсутствие.
enum AstroTimeAccuracy {
  exact
  approximate
  unknown
}

/// Данные рождения. Отдельно от `User`: у портала есть только дата, а карте нужны
/// ещё время, место и часовой пояс.
model AstroBirthData {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Момент рождения в UTC — единственный источник истины для расчёта карты.
  bornAtUtc      DateTime
  /// Дата и время так, как их ввёл человек, по месту рождения. Хранятся отдельно,
  /// чтобы показать их обратно без обратного пересчёта и чтобы правка часового
  /// пояса не требовала догадываться, что было введено изначально.
  birthDateLocal DateTime          @db.Date
  birthTimeLocal String?
  timeAccuracy   AstroTimeAccuracy @default(exact)

  placeLabel String
  latitude   Float
  longitude  Float
  /// Идентификатор зоны IANA. Определяется по координатам, но может быть
  /// переопределён вручную для приграничных мест.
  timezone   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Раздел ИИ-разбора карты.
enum AstroSection {
  overview
  lagna
  moon_nakshatra
  dasha_current
  career
  relationships
  strengths
  practice
}

/// Интерпретация раздела. Ключуется отпечатком карты, а не пользователем: карта
/// детерминирована, поэтому таблицу самих карт держать не нужно, а текст про
/// одинаковые карты одинаков (у близнецов кэш общий — это верно по существу).
/// Версия промпта входит в ключ: правка промпта инвалидирует кэш без миграций.
model AstroReading {
  id               String       @id @default(uuid())
  chartFingerprint String
  section          AstroSection
  locale           String
  promptVersion    String
  text             String
  model            String
  tokensIn         Int
  tokensOut        Int
  createdAt        DateTime     @default(now())

  @@unique([chartFingerprint, section, locale, promptVersion])
}

/// Расход пользователя за сутки. Ключ по дню — сброс квоты не требует джоба.
model AstroUsage {
  userId    String
  day       DateTime @db.Date
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readings  Int      @default(0)
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)

  @@id([userId, day])
}

/// Расход всего сервиса за сутки. `haltedAt` не null — сработал kill-switch.
model AstroBudgetDay {
  day          DateTime  @id @db.Date
  tokensIn     Int       @default(0)
  tokensOut    Int       @default(0)
  costUsdCents Int       @default(0)
  haltedAt     DateTime?
}

/// Единственная строка настроек сервиса (id всегда "global"). Правится из админки,
/// чтобы менять лимиты без передеплоя.
model AstroSettings {
  id                     String   @id @default("global")
  enabled                Boolean  @default(true)
  /// Аварийный выключатель ИИ: карта считается и показывается, тексты — только из кэша.
  aiEnabled              Boolean  @default(true)
  dailyReadingsPerUser   Int      @default(3)
  dailyTokensPerUser     Int      @default(20000)
  dailyTokenBudget       Int      @default(2000000)
  dailyCostLimitUsdCents Int      @default(1000)
  transitPushEnabled     Boolean  @default(true)
  updatedAt              DateTime @updatedAt
}

/// Статус запроса на сопоставление карт. Согласие — свой процесс внутри astro,
/// не зависящий от статуса анкет в Union: инициатор может быть кем угодно из
/// пользователей портала, а не только участником взаимного мэтча.
enum AstroCompatibilityStatus {
  pending
  accepted
  declined
}

/// Запрос на сопоставление карт двух пользователей. Обе карты закрыты, пока
/// получатель не примет запрос явно — точка входа из Union передаёт только id
/// человека, дальнейшее согласие целиком в astro.
model AstroCompatibilityRequest {
  id          String                   @id @default(uuid())
  requesterId String
  requester   User                     @relation("AstroCompatibilityRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetId    String
  target      User                     @relation("AstroCompatibilityTarget", fields: [targetId], references: [id], onDelete: Cascade)
  status      AstroCompatibilityStatus @default(pending)
  createdAt   DateTime                 @default(now())
  respondedAt DateTime?

  @@unique([requesterId, targetId])
  @@index([targetId, status])
}

/// ИИ-разбор сопоставления. Ключ — отсортированная пара отпечатков карт, поэтому
/// не важно, кто из двоих инициатор: разбор одной и той же пары карт один.
model AstroCompatibilityReading {
  id            String   @id @default(uuid())
  /// `${меньший отпечаток}:${больший отпечаток}` — сортировка убирает направление.
  pairKey       String
  locale        String
  promptVersion String
  text          String
  model         String
  tokensIn      Int
  tokensOut     Int
  createdAt     DateTime @default(now())

  @@unique([pairKey, locale, promptVersion])
}

/// Дневной дайджест транзитов пользователя. Данные — детерминированный расчёт,
/// хранятся всегда; текст и pushedAt заполняются только если дошло до отправки.
model AstroTransitDigest {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  forDate   DateTime  @db.Date
  data      Json
  text      String?
  pushedAt  DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, forDate])
}

/// Готовая фраза под транзитный паттерн, общая на весь портал. Ключевая
/// экономия дня: паттерн — это бхава транзитной Луны относительно лагны
/// человека (1..12), а не сам человек, поэтому вариантов конечное малое число
/// независимо от размера базы пользователей.
model AstroTransitPhrase {
  id            String   @id @default(uuid())
  patternKey    String
  locale        String
  promptVersion String
  text          String
  createdAt     DateTime @default(now())

  @@unique([patternKey, locale, promptVersion])
}

// ===== Changelog / product updates (публичная страница «Версия и новости») =====

enum ReleaseChangeType {
  feature
  fix
  improvement
}

enum RoadmapStatus {
  planned
  in_progress
  done
}

enum AnnouncementStatus {
  draft
  published
}

model Release {
  id         String   @id @default(uuid())
  version    String   @unique
  /// true только у одной записи — актуальная версия на публичной странице.
  /// Сервис снимает флаг с прежней записи в той же транзакции.
  isCurrent  Boolean  @default(false)
  releasedAt DateTime @db.Date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  changes ReleaseChange[]

  @@index([isCurrent])
  @@index([releasedAt(sort: Desc)])
}

model ReleaseChange {
  id        String            @id @default(uuid())
  releaseId String
  release   Release           @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  type      ReleaseChangeType
  titleRu   String
  titleEn   String
  sortOrder Int               @default(0)

  @@index([releaseId, sortOrder])
}

model Announcement {
  id          String             @id @default(uuid())
  titleRu     String
  titleEn     String
  bodyRu      String
  bodyEn      String
  status      AnnouncementStatus @default(draft)
  publishedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, publishedAt(sort: Desc)])
}

model RoadmapItem {
  id            String        @id @default(uuid())
  titleRu       String
  titleEn       String
  descriptionRu String?
  descriptionEn String?
  status        RoadmapStatus @default(planned)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, sortOrder])
}

// ===== Contacts service =====

/// Кто видит карточку в справочнике. `by_link` — карточки нет в выдаче,
/// но она открывается по прямой ссылке, которую человек дал сам.
enum ContactsVisibility {
  everyone
  verified_only
  same_city
  by_link
  hidden
}

/// Состояние карточки. Справочник услуг притягивает спам, поэтому карточка
/// с коммерческими тегами проходит через `pending`.
enum ContactsProfileStatus {
  draft
  pending
  active
}

/// Ашрам — закрытый и стабильный набор, поэтому enum, а не тег.
enum ContactsAshram {
  brahmachari
  grihastha
  vanaprastha
  sannyasi
}

enum ContactsFormat {
  online
  offline
  any
}

/// Виды тегов справочника. Растут постоянно, поэтому значения живут
/// в таблице `ContactsTag`, а enum описывает только разделы.
enum ContactsTagKind {
  service
  profession
  skill
  interest
}

/// Карточка в справочнике. Создаётся явным действием человека: справочник
/// opt-in, портальный профиль сам по себе в него не попадает.
model ContactsProfile {
  id                       String                @id @default(uuid())
  userId                   String                @unique
  user                     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Короткая строка «чем полезен» — заголовок карточки в выдаче.
  headline                 String?
  about                    String?
  /// Что человек предлагает и с чем готов помочь.
  offers                   String?
  languages                String[]              @default([])
  ashram                   ContactsAshram?
  format                   ContactsFormat        @default(any)
  visibility               ContactsVisibility    @default(hidden)
  status                   ContactsProfileStatus @default(draft)
  /// Пауза: до этой даты карточка не показывается и возвращается сама.
  pausedUntil              DateTime?
  /// Видимость отдельных полей: { city, photo, age } со значениями
  /// 'everyone' | 'hidden'. Не связана с приватностью Union — в справочнике
  /// человек может открыть то, что закрыл в знакомствах.
  fieldPrivacy             Json?
  /// Обращения только от подтверждённых преданных.
  requestsFromVerifiedOnly Boolean               @default(false)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  tags ContactsProfileTag[]

  @@index([status, visibility])
}

/// Справочник тегов. Системные приезжают сидом, пользовательские — через
/// модерацию, поэтому новый вид служения не требует миграции БД.
model ContactsTag {
  id        String          @id @default(uuid())
  slug      String          @unique
  kind      ContactsTagKind
  nameRu    String
  isSystem  Boolean         @default(true)
  sortOrder Int             @default(0)

  profiles ContactsProfileTag[]

  @@index([kind, sortOrder])
}

model ContactsProfileTag {
  profileId String
  profile   ContactsProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tagId     String
  tag       ContactsTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([profileId, tagId])
  @@index([tagId])
}

/// Запрос контакта. В отличие от заявки в Union это не про отношения,
/// а про один конкретный вопрос: можно ли получить способ связаться.
enum ContactsRequestStatus {
  pending
  accepted
  declined
  cancelled
}

model ContactsRequest {
  id          String                @id @default(uuid())
  fromUserId  String
  fromUser    User                  @relation("ContactsRequestsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User                  @relation("ContactsRequestsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  message     String?
  status      ContactsRequestStatus @default(pending)
  createdAt   DateTime              @default(now())
  respondedAt DateTime?

  disclosure ContactsDisclosure?

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId, createdAt])
}

/// Журнал раскрытий: кому владелец открыл свои контакты и когда закрыл обратно.
/// Отзыв не удаляет строку — человек должен видеть историю, а не чистый лист.
model ContactsDisclosure {
  id        String           @id @default(uuid())
  ownerId   String
  owner     User             @relation("ContactsDisclosuresGranted", fields: [ownerId], references: [id], onDelete: Cascade)
  viewerId  String
  viewer    User             @relation("ContactsDisclosuresReceived", fields: [viewerId], references: [id], onDelete: Cascade)
  requestId String?          @unique
  request   ContactsRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  grantedAt DateTime         @default(now())
  revokedAt DateTime?

  @@unique([ownerId, viewerId])
  @@index([viewerId, revokedAt])
}

// ===== Market service =====

enum MarketListingKind {
  product
  service
}

enum MarketListingStatus {
  draft
  published
  hidden_by_author
  sold_out
  hidden_by_reports
  removed_by_admin
}

/// `new` — зарезервированное слово в слишком многих местах, поэтому `new_item`.
enum MarketListingCondition {
  new_item
  like_new
  used
  refurbished
}

/// `negotiable` — «цена договорная», `free` — отдам даром: цена в обоих случаях
/// null, но это разные вещи и разные подписи в карточке.
enum MarketPriceMode {
  fixed
  from
  negotiable
  free
}

enum MarketCurrency {
  rub
  usd
  eur
  inr
}

enum MarketDeliveryOption {
  pickup
  courier
  post
  cdek
  digital
  shipping_worldwide
}

enum MarketServiceFormat {
  online
  offline
  any
}

enum MarketShopStatus {
  active
  closed
  hidden_by_reports
  blocked_by_admin
}

/// Верхний уровень каталога: «Одежда», «Книги», «Услуги». Только сид и админ.
model MarketSection {
  id            String   @id @default(uuid())
  slug          String   @unique
  titleRu       String
  titleEn       String
  descriptionRu String?
  descriptionEn String?
  iconKey       String?
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categories    MarketCategory[]
  subscriptions MarketSubscription[]

  @@index([position])
}

/// Второй уровень каталога. В отличие от библиотеки — только сид и админ:
/// на категориях висят фильтры выдачи, пользовательский дрейф их ломает.
/// Поэтому здесь нет normalized*-колонок и pg_trgm: Рынок не добавляет
/// ни одного объекта в docs/prisma-raw-sql-objects.md.
model MarketCategory {
  id            String        @id @default(uuid())
  sectionId     String
  section       MarketSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  slug          String
  titleRu       String
  titleEn       String
  descriptionRu String?
  descriptionEn String?
  position      Int           @default(0)
  /// Денормализованный счётчик опубликованных объявлений — для строки каталога.
  listingsCount Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  listings      MarketListingCategory[]
  subscriptions MarketSubscription[]

  @@unique([sectionId, slug])
  @@index([sectionId, position])
  @@index([listingsCount(sort: Desc)])
}

/// Магазин. Один на пользователя: второй витриной никто не пользуется, а снять
/// @unique дешевле миграцией, чем потом чинить выбор «от чьего имени публикуем».
/// Гео продублировано скалярными колонками рядом с `location`: JSON в Postgres
/// не индексируется, а по городу идёт фильтр выдачи.
model MarketShop {
  id        String  @id @default(uuid())
  ownerId   String  @unique
  owner     User    @relation("MarketShopOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  slug      String  @unique
  /// Название — имя собственное, поэтому одно поле, а не пара Ru/En.
  name      String
  taglineRu String?
  taglineEn String?
  aboutRu   String?
  aboutEn   String?

  logoKey  String?
  logoUrl  String?
  coverKey String?
  coverUrl String?

  /// ProfileLocation целиком — чтобы вернуть в форму без обратного пересчёта.
  location  Json?
  city      String?
  /// Нормализованный город (trim + lower) для фильтра по равенству; см. common/city-key.ts.
  cityKey   String?
  country   String?
  latitude  Float?
  longitude Float?

  /// Способы связи вне платформы: ProfileMessengers-совместимый объект.
  messengers Json?

  deliveryOptions MarketDeliveryOption[]
  status          MarketShopStatus       @default(active)
  /// Момент согласия с правилами Рынка. null — магазин создан до их введения.
  rulesAcceptedAt DateTime?

  listingsCount    Int   @default(0)
  ordersCount      Int   @default(0)
  reviewsCount     Int   @default(0)
  /// Сумма оценок; среднее держим отдельной колонкой, чтобы сортировать
  /// выдачу магазинов без подзапроса.
  ratingSum        Int   @default(0)
  ratingAvg        Float @default(0)
  followersCount   Int   @default(0)
  openReportsCount Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings      MarketListing[]
  shelves       MarketShelf[]
  orders        MarketOrder[]
  conversations MarketConversation[]
  reviews       MarketReview[]
  reports       MarketReport[]
  subscriptions MarketSubscription[]

  @@index([status, createdAt(sort: Desc)])
  @@index([status, ratingAvg(sort: Desc)])
  @@index([city])
  @@index([status, cityKey])
}

/// Полка внутри магазина — навигация по своей витрине, независимая от
/// глобального каталога.
model MarketShelf {
  id            String     @id @default(uuid())
  shopId        String
  shop          MarketShop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  slug          String
  titleRu       String?
  titleEn       String?
  position      Int        @default(0)
  listingsCount Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  listings MarketListingShelf[]

  @@unique([shopId, slug])
  @@index([shopId, position])
}

/// Объявление. Товар и услуга — одна модель: различий три поля, а не сущность.
/// У товара condition/quantity, у услуги serviceFormat/длительность.
/// Цена в минорных единицах Int: точная арифметика, прямое сравнение в
/// диапазонном фильтре и честный JSON в DTO (Decimal не сериализуется).
model MarketListing {
  id     String            @id @default(uuid())
  shopId String
  shop   MarketShop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  kind   MarketListingKind

  titleRu       String?
  titleEn       String?
  descriptionRu String?
  descriptionEn String?

  priceMode     MarketPriceMode @default(fixed)
  /// Минорные единицы (копейки/центы). null у negotiable и free.
  priceMinor    Int?
  /// Верх «вилки» для priceMode=from; null — вилки нет.
  priceMaxMinor Int?
  currency      MarketCurrency  @default(rub)

  /// Только товар.
  condition  MarketListingCondition?
  /// null — количество не отслеживается (услуга, цифровой товар, «в наличии»).
  quantity   Int?
  trackStock Boolean                 @default(false)
  soldCount  Int                     @default(0)

  /// Только услуга.
  serviceFormat          MarketServiceFormat?
  serviceDurationMinutes Int?

  /// Копия геоданных магазина на момент создания; продавец может переопределить
  /// (мастерская в другом городе), поэтому это свои колонки, а не ссылка.
  location  Json?
  city      String?
  /// Нормализованный город (trim + lower) для фильтра по равенству; см. common/city-key.ts.
  cityKey   String?
  country   String?
  latitude  Float?
  longitude Float?

  deliveryOptions MarketDeliveryOption[]

  status      MarketListingStatus @default(published)
  needsReview Boolean             @default(false)

  /// Первая картинка по sortOrder — чтобы лента не тянула связь.
  primaryImageUrl String?

  viewsCount       Int @default(0)
  favoritesCount   Int @default(0)
  commentsCount    Int @default(0)
  ordersCount      Int @default(0)
  openReportsCount Int @default(0)

  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images        MarketListingImage[]
  categories    MarketListingCategory[]
  shelves       MarketListingShelf[]
  favorites     MarketFavorite[]
  cartItems     MarketCartItem[]
  orderItems    MarketOrderItem[]
  conversations MarketConversation[]
  reviews       MarketReview[]
  comments      MarketListingComment[]
  reports       MarketReport[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([shopId, status, publishedAt(sort: Desc)])
  @@index([status, kind, publishedAt(sort: Desc)])
  @@index([status, currency, priceMinor])
  @@index([status, city])
  @@index([status, cityKey])
  @@index([status, favoritesCount(sort: Desc)])
}

/// Фото объявления. Публичные объекты в S3 — витрина попадает в SSR-HTML
/// и должна кешироваться CDN, поэтому не пресайн, как в галерее профиля.
model MarketListingImage {
  id         String        @id @default(uuid())
  listingId  String
  listing    MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  storageKey String        @unique
  url        String
  width      Int
  height     Int
  sizeBytes  Int
  sortOrder  Int
  createdAt  DateTime      @default(now())

  @@index([listingId, sortOrder])
}

/// Объявление ↔ глобальная категория.
model MarketListingCategory {
  listingId  String
  listing    MarketListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  categoryId String
  category   MarketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@id([listingId, categoryId])
  @@index([categoryId])
}

/// Объявление ↔ полка магазина.
model MarketListingShelf {
  listingId String
  listing   MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  shelfId   String
  shelf     MarketShelf   @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  position  Int           @default(0)

  @@id([listingId, shelfId])
  @@index([shelfId, position])
}

/// Избранное. priceAtFavorite — база для уведомления «стало дешевле»:
/// без снимка цены на момент добавления сравнивать не с чем.
model MarketFavorite {
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId       String
  listing         MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  priceAtFavorite Int?
  createdAt       DateTime      @default(now())

  @@id([userId, listingId])
  @@index([listingId])
  @@index([userId, createdAt(sort: Desc)])
}

/// Настройки Рынка у пользователя. Отсутствие строки = значения по умолчанию.
model MarketPreference {
  userId          String         @id
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  uiLanguage      String         @default("ru") @db.VarChar(8)
  displayCurrency MarketCurrency @default(rub)
  priceDropAlerts Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// ===== Market service: корзина, заявки, чат (фаза 2) =====

/// Оплаты на Рынке нет: заявка — это намерение купить, а деньги и доставку
/// стороны обсуждают в чате. Отсюда и названия статусов: `new_request`,
/// а не `new`, чтобы никто не принял её за оплаченный заказ.
enum MarketOrderStatus {
  new_request
  accepted
  in_progress
  completed
  declined_by_seller
  cancelled_by_buyer
}

/// Корзина одна и глобальная, поэтому отдельной модели «корзина» нет: строки,
/// сгруппированные по userId, и есть корзина. Разбиение по магазинам и валютам
/// происходит только в момент оформления.
model MarketCartItem {
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  /// У услуги всегда 1: количество там бессмысленно.
  quantity  Int           @default(1)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@id([userId, listingId])
  @@index([listingId])
  @@index([userId, createdAt(sort: Desc)])
}

/// Заявка продавцу. Одна заявка = один магазин и одна валюта: складывать
/// рубли с рупиями в totalMinor нельзя, поэтому корзина при оформлении
/// делится по паре (магазин, валюта).
model MarketOrder {
  id      String     @id @default(uuid())
  /// Человекочитаемый номер — как у SupportTicket: «заявка №42» в переписке
  /// понятнее, чем uuid.
  number  Int        @unique @default(autoincrement())
  buyerId String
  buyer   User       @relation("MarketOrdersPlaced", fields: [buyerId], references: [id], onDelete: Cascade)
  shopId  String
  shop    MarketShop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  status         MarketOrderStatus     @default(new_request)
  /// Снимок суммы: цены объявлений после оформления меняются.
  totalMinor     Int
  currency       MarketCurrency
  deliveryOption MarketDeliveryOption?
  deliveryNote   String?
  buyerComment   String?
  declineReason  String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  acceptedAt  DateTime?
  completedAt DateTime?
  closedAt    DateTime?

  items         MarketOrderItem[]
  conversations MarketConversation[]
  /// Один отзыв на заявку — это правило выражено @unique на MarketReview.orderId.
  review        MarketReview?

  @@index([buyerId, createdAt(sort: Desc)])
  @@index([shopId, status, createdAt(sort: Desc)])
}

/// Позиция заявки со снимком названия и цены: объявление могут отредактировать
/// или удалить, а заявка обязана остаться читаемой. Поэтому listingId — SetNull,
/// а не Cascade: уборка у продавца не стирает историю покупателя.
model MarketOrderItem {
  id             String         @id @default(uuid())
  orderId        String
  order          MarketOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId      String?
  listing        MarketListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  titleSnapshot  String
  priceMinor     Int
  currency       MarketCurrency
  imageUrl       String?
  quantity       Int            @default(1)
  lineTotalMinor Int

  @@index([orderId])
  @@index([listingId])
}

/// Диалог покупатель ↔ магазин. Один на пару: listingId и orderId — это повод,
/// с которого начали разговор, а не ключ диалога. Иначе у одних и тех же людей
/// накапливались бы параллельные переписки на каждый товар.
model MarketConversation {
  id            String         @id @default(uuid())
  shopId        String
  shop          MarketShop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         User           @relation("MarketConversationsAsBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  listingId     String?
  listing       MarketListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  orderId       String?
  order         MarketOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  lastMessageAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  messages MarketMessage[]

  @@unique([shopId, buyerId])
  @@index([buyerId, lastMessageAt(sort: Desc)])
  @@index([shopId, lastMessageAt(sort: Desc)])
}

/// Сообщение. readAt и editedAt — как в UnionChatMessage; индекс по readAt
/// нужен для подсчёта непрочитанного одним groupBy.
model MarketMessage {
  id             String             @id @default(uuid())
  conversationId String
  conversation   MarketConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fromUserId     String
  fromUser       User               @relation("MarketMessagesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  body           String
  readAt         DateTime?
  editedAt       DateTime?
  createdAt      DateTime           @default(now())

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
  @@index([fromUserId])
}

// ===== Market service: отзывы, подписки, модерация (фаза 3) =====

enum MarketReviewStatus {
  published
  removed_by_author
  removed_by_admin
}

enum MarketCommentStatus {
  published
  removed_by_author
  removed_by_admin
}

enum MarketSubscriptionKind {
  shop
  section
  category
  saved_search
}

enum MarketReportTargetKind {
  listing
  shop
  comment
  review
}

enum MarketReportReason {
  spam
  prohibited_item
  scam
  wrong_category
  inappropriate_content
  other
}

enum MarketReportStatus {
  open
  reviewed
  dismissed
}

/// Отзыв. Только по завершённой заявке и ровно один на заявку: `@unique` на
/// orderId и есть это правило — проверять его в коде было бы дублированием.
/// Так рейтинг нельзя накрутить, не пройдя через реальную сделку.
model MarketReview {
  id               String             @id @default(uuid())
  orderId          String             @unique
  order            MarketOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopId           String
  shop             MarketShop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  listingId        String?
  listing          MarketListing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)
  authorId         String?
  author           User?              @relation("MarketReviewsWritten", fields: [authorId], references: [id], onDelete: SetNull)
  /// 1..5, проверяется в сервисе: у Postgres нет дешёвого способа выразить
  /// диапазон без CHECK-констрейнта, которого Prisma не умеет.
  rating           Int
  body             String?
  status           MarketReviewStatus @default(published)
  openReportsCount Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  reports MarketReport[]

  @@index([shopId, status, createdAt(sort: Desc)])
  @@index([authorId])
}

/// Вопрос или комментарий под объявлением — без оценки и без заявки.
/// Плоские, как LibraryComment: ветки здесь избыточны, а удалённые остаются
/// строкой со статусом, чтобы не рвать переписку.
model MarketListingComment {
  id               String              @id @default(uuid())
  listingId        String
  listing          MarketListing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?               @relation("MarketCommentsWritten", fields: [userId], references: [id], onDelete: SetNull)
  body             String
  status           MarketCommentStatus @default(published)
  openReportsCount Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  reports MarketReport[]

  @@index([listingId, createdAt])
  @@index([userId])
}

/// Подписка «сообщать о новом». Одна таблица на четыре вида: три из них —
/// пара (пользователь, цель), четвёртый несёт фильтры поиска.
///
/// `targetKey` нужен потому, что уникальный индекс с NULL в Postgres не
/// дедуплицирует: `@@unique([userId, kind, shopId, sectionId, categoryId])`
/// пропустил бы сколько угодно одинаковых строк с NULL в неиспользуемых
/// колонках. Здесь это id цели либо стабильный хеш фильтров.
model MarketSubscription {
  id             String                 @id @default(uuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           MarketSubscriptionKind
  targetKey      String
  shopId         String?
  shop           MarketShop?            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sectionId      String?
  section        MarketSection?         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       MarketCategory?        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Фильтры сохранённого поиска — тот же объект, что в query-строке ленты.
  query          Json?
  /// Как назвал подписку пользователь; null — подпись собирается из цели.
  title          String?
  lastNotifiedAt DateTime?
  createdAt      DateTime               @default(now())

  @@unique([userId, kind, targetKey])
  @@index([kind, targetKey])
  @@index([userId, createdAt(sort: Desc)])
}

/// Жалоба внутри Рынка. Своя таблица, а не портальный UserReport: цель —
/// объявление или магазин, а не пользователь, и связь с моделями чужого
/// модуля запрещена контрактом.
///
/// `targetKey` — по той же причине, что и в подписках: уникальность «одна
/// жалоба от человека на объект» через колонки с NULL не выражается.
model MarketReport {
  id         String                 @id @default(uuid())
  reporterId String
  reporter   User                   @relation("MarketReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  targetKind MarketReportTargetKind
  targetKey  String
  listingId  String?
  listing    MarketListing?         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  shopId     String?
  shop       MarketShop?            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    MarketListingComment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reviewId   String?
  review     MarketReview?          @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  reason        MarketReportReason
  note          String?
  status        MarketReportStatus @default(open)
  reviewedById  String?
  reviewedBy    User?              @relation("MarketReportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  moderatorNote String?
  createdAt     DateTime           @default(now())

  @@unique([reporterId, targetKey])
  @@index([status, createdAt])
  @@index([listingId])
  @@index([shopId])
}

// ===== Communities (portal) =====
//
// Ятры, храмы, нама-хатты и клубы. Это портальная инфраструктура, а не модели
// сервиса, и потому здесь нет префикса: принадлежность к общине — сквозной
// признак человека, она видна в профиле, в знакомствах, в справочнике и в
// объявлениях одновременно. Копия внутри одного сервиса разъехалась бы с
// остальными на первой же правке. Сервисы читают эти таблицы только read-only
// и только через CommunitiesService — см. docs/service-module-contract.md.

enum CommunityKind {
  yatra
  temple
  ashram
  nama_hatta
  farm
  club
  center
  project
}

/// `pending` — заведена человеком и ждёт разбора администрацией. Свободное
/// создание закрыто намеренно: справочник ятр зарастает дублями «Москва»,
/// «Москва ятра», «ятра г. Москва» быстрее всего остального, а склеивать их
/// задним числом дороже, чем один раз посмотреть заявку.
enum CommunityStatus {
  draft
  pending
  active
  paused
  archived
  hidden_by_reports
  removed_by_admin
}

enum CommunityJoinPolicy {
  open
  request_approval
  invite_only
}

/// `moderator` заведён под делегированную модерацию Объявлений: скрыть
/// объявление своей общины, но не править саму общину. Без делегирования
/// доска не масштабируется — портальная администрация станет узким местом.
enum CommunityMemberRole {
  owner
  admin
  moderator
  member
}

/// `left` и `removed` различаются намеренно: ушедший может вернуться сам,
/// исключённого возвращает только админ общины.
enum CommunityMemberStatus {
  pending
  active
  declined
  left
  removed
}

/// Община. Гео продублировано скалярными колонками рядом с `location`: JSON в
/// Postgres не индексируется, а по городу идёт фильтр справочника — та же
/// денормализация, что у `MarketShop`.
model Community {
  id   String        @id @default(uuid())
  slug String        @unique
  kind CommunityKind

  /// Название — имя собственное, поэтому одно поле, а не пара Ru/En.
  name          String
  descriptionRu String?
  descriptionEn String?

  logoKey  String?
  logoUrl  String?
  coverKey String?
  coverUrl String?

  /// ProfileLocation целиком — чтобы вернуть в форму без обратного пересчёта.
  location  Json?
  city      String?
  /// Нормализованный город (trim + lower) для фильтра по равенству; см. common/city-key.ts.
  cityKey   String?
  country   String?
  latitude  Float?
  longitude Float?
  /// Точный адрес. У храма он публичный — в отличие от дома человека, который
  /// на карте портала не показывается никогда.
  address   String?
  /// IANA-зона места. Нужна, чтобы «воскресная программа в 17:00» означала
  /// 17:00 там, а не у смотрящего: одного UTC-момента для этого мало.
  timezone  String?

  /// ProfileMessengers-совместимый объект: как связаться с общиной.
  messengers Json?
  /// ProfileSocialLinks-совместимый объект: сайт, канал, группа.
  links      Json?

  joinPolicy CommunityJoinPolicy @default(request_approval)
  status     CommunityStatus     @default(pending)

  /// Отметка администрации «это действительно та община, за которую себя
  /// выдают». Сильнее, чем `active`: `active` означает лишь, что это не дубль.
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("CommunityVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("CommunityCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// Денормализованные счётчики — для строки справочника без подзапроса.
  membersCount     Int @default(0)
  noticesCount     Int @default(0)
  openReportsCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             CommunityMember[]
  ownershipTransfers  CommunityOwnershipTransfer[]
  notices             Notice[]                     @relation("NoticeAuthorCommunity")
  noticeSubscriptions NoticeSubscription[]         @relation("NoticeSubscriptions")

  @@index([status, city])
  @@index([status, cityKey])
  @@index([status, kind])
  @@index([status, membersCount(sort: Desc)])
}

/// Участие человека в общине. Роль и статус разведены: заявка на вступление —
/// это строка со `status: pending` и ролью `member`, а не отдельная таблица
/// заявок, иначе принятие заявки означало бы перенос строки между таблицами.
model CommunityMember {
  id          String                @id @default(uuid())
  communityId String
  community   Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User                  @relation("CommunityMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role        CommunityMemberRole   @default(member)
  status      CommunityMemberStatus @default(pending)
  /// Служение внутри общины свободным текстом: «пуджари», «координатор кухни».
  /// Не роль: роль управляет правами, это — подпись в списке участников.
  title       String?
  /// Какая из общин человека показывается значком в профиле. Ровно одна на
  /// человека; частичный уникальный индекс Prisma выразить не умеет, поэтому
  /// инвариант держит сервис — снимает флаг с прежней в той же транзакции.
  isPrimary   Boolean               @default(false)
  /// Показывать ли участие публично. Само по себе оно не тайна, но связывать
  /// себя с общиной на людях человек не обязан.
  isPublic    Boolean               @default(true)

  joinedAt    DateTime?
  decidedById String?
  decidedBy   User?     @relation("CommunityMemberDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  /// Когда по членству приняли решение — вступил, отказали, исключили.
  /// От него отсчитывается пауза перед повторной заявкой: без неё отказ
  /// ничего не значит, заявку переотправят в тот же вечер.
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([communityId, userId])
  @@index([userId, status])
  @@index([communityId, status, role])
}

/// Передача владения общиной. Отдельная таблица, а не присваивание поля:
/// смена владельца требует согласия принимающего, иначе общину можно
/// «подарить» человеку, который об этом не просил, и повесить на него
/// ответственность за модерацию.
model CommunityOwnershipTransfer {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  fromUserId  String
  fromUser    User      @relation("CommunityTransfersSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User      @relation("CommunityTransfersReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  /// Непринятое предложение протухает: висящая вечно передача владения —
  /// это мина, которая срабатывает через год после того, как о ней забыли.
  expiresAt   DateTime
  acceptedAt  DateTime?
  declinedAt  DateTime?

  @@index([toUserId, acceptedAt, declinedAt])
  @@index([communityId, createdAt(sort: Desc)])
}

// ===== Notices service =====
//
// Некоммерческая доска общины. Ключевое отличие от Рынка — структурное:
// здесь НЕТ НИ ОДНОГО денежного поля. Не «необязательная цена», а
// отсутствующая: чтобы что-то продать в Объявлениях, придётся сначала
// изменить схему. Это единственная граница между сервисами, которая
// держится сама, без надзора. См. docs/notices-service-plan.md.

/// Вид объявления. Закрытый набор из четырёх значений: вид меняет форму,
/// обязательные поля и срок жизни, то есть код, а не данные. Всё, что растёт
/// (тематика), живёт таблицей NoticeRubric.
enum NoticeKind {
  offer
  request
  event
  info
}

/// `resolved` и `expired` разведены намеренно: «вопрос решён» и «протухло
/// само» — разные факты. Первое закрывает просьбу и идёт в статистику помощи,
/// второе продлевается одной кнопкой.
///
/// `moved_to_market` — модератор увидел коммерцию. Автоматического переноса
/// записи в Рынок нет и быть не может: связь с моделями чужого сервиса
/// запрещена контрактом, автор переносит текст сам по готовой ссылке.
enum NoticeStatus {
  draft
  published
  hidden_by_author
  resolved
  expired
  moved_to_market
  hidden_by_reports
  removed_by_admin
}

/// Точность места. Главное приватностное решение сервиса: объявление
/// человека НИКОГДА не ставит метку на его дом. `exact` разрешён, только
/// когда место общественное — храм, площадка события. Понижает сервер,
/// клиент переопределить не может.
enum NoticePlacePrecision {
  exact
  city
}

/// Кому видно. `my_community` — объявление внутри ятры: сбор на храм или
/// служение, которое незачем показывать всему порталу.
enum NoticeAudience {
  everyone
  my_city
  my_community
}

/// Рубрика доски. Таблица, а не enum: тематика растёт постоянно, и каждое
/// добавление миграцией — тупик (то же решение, что у ContactsTag).
/// Один уровень: на доске взаимопомощи второй уровень пустует, а вложенность
/// ломает лёгкость публикации.
model NoticeRubric {
  id           String       @id @default(uuid())
  slug         String       @unique
  /// Виды, в которых рубрика предлагается. Пустой массив — во всех:
  /// «разное» уместно и в просьбе, и в предложении.
  kinds        NoticeKind[]
  nameRu       String
  nameEn       String
  iconKey      String?
  isSystem     Boolean      @default(true)
  position     Int          @default(0)
  /// Денормализованный счётчик опубликованных — для строки навигации.
  noticesCount Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  notices       Notice[]
  subscriptions NoticeSubscription[]

  @@index([position])
  @@index([noticesCount(sort: Desc)])
}

/// Объявление. Все виды — одна модель: различий между ними десяток полей,
/// а не сущность (тот же вывод, что у MarketListing про товар и услугу).
///
/// Автор ВСЕГДА человек, даже когда публикуют от имени общины: за текстом
/// стоит конкретный преданный, и при разборе жалобы нужно знать, кто именно
/// написал. `communityId` — только «от чьего имени показано»; право его
/// проставить проверяется через CommunitiesService.canPostAs и на создании,
/// и на правке: роль могли снять.
model Notice {
  id       String       @id @default(uuid())
  kind     NoticeKind
  rubricId String
  rubric   NoticeRubric @relation(fields: [rubricId], references: [id])

  authorId    String
  author      User       @relation("NoticesAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  /// От имени общины. null — от себя лично.
  communityId String?
  community   Community? @relation("NoticeAuthorCommunity", fields: [communityId], references: [id], onDelete: SetNull)

  /// Пара Ru/En, как у MarketListing: человек заполняет одну, вторая
  /// остаётся пустой, а выдача подставляет ту, что есть.
  titleRu       String?
  titleEn       String?
  descriptionRu String?
  descriptionEn String?

  audience NoticeAudience @default(everyone)

  /// Гео. Денормализовано скалярами рядом с `location` по той же причине,
  /// что в MarketShop: JSON в Postgres не индексируется, а по городу идёт
  /// фильтр ленты.
  location       Json?
  city           String?
  /// Нормализованный город (trim + lower) для фильтра по равенству; см. common/city-key.ts.
  cityKey        String?
  country        String?
  latitude       Float?
  longitude      Float?
  placePrecision NoticePlacePrecision @default(city)

  /// Событие. `timeZone` хранится рядом с `startsAt` намеренно: одного
  /// UTC-момента мало — «программа в 17:00» должна остаться 17:00 по месту
  /// проведения, куда бы ни переехал смотрящий.
  startsAt    DateTime?
  endsAt      DateTime?
  timeZone    String?
  venueName   String?
  isOnline    Boolean          @default(false)
  onlineUrl   String?
  repeat      NoticeRecurrence @default(none)
  /// До какой даты повторять. null у повторяющегося события — «пока не
  /// отменят»: разворачивание всё равно ограничено окном запроса.
  repeatUntil DateTime?

  status                NoticeStatus @default(published)
  needsReview           Boolean      @default(false)
  /// Модератор предложил перенести в Рынок; автору уходит ссылка с текстом.
  marketMoveSuggestedAt DateTime?
  moderatorNote         String?

  /// Отпечаток нормализованного текста: один автор не публикует одно и то же
  /// дважды. Считается чистой функцией notice-fingerprint.ts.
  fingerprint String

  /// Первая картинка по sortOrder — чтобы лента не тянула связь.
  primaryImageUrl String?

  /// `publishedAt` при продлении НЕ меняется: иначе «продлить» стало бы
  /// бесплатным подъёмом в топ, и лента превратилась бы в соревнование по
  /// нажатию кнопки.
  publishedAt DateTime  @default(now())
  expiresAt   DateTime
  renewedAt   DateTime?
  renewCount  Int       @default(0)
  resolvedAt  DateTime?

  viewsCount       Int @default(0)
  responsesCount   Int @default(0)
  thanksCount      Int @default(0)
  openReportsCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images    NoticeImage[]
  responses NoticeResponse[]
  thanks    NoticeThanks[]
  reports   NoticeReport[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([status, kind, publishedAt(sort: Desc)])
  @@index([status, rubricId, publishedAt(sort: Desc)])
  @@index([status, city, publishedAt(sort: Desc)])
  @@index([status, cityKey, publishedAt(sort: Desc)])
  /// Воркер протухания ходит только по этому индексу.
  @@index([status, expiresAt])
  /// Афиша и календарь.
  @@index([status, startsAt])
  /// Радиус и рамка карты: подзапрос по координатам среди живых.
  @@index([status, latitude, longitude])
  @@index([communityId, status, publishedAt(sort: Desc)])
  @@index([authorId, status, createdAt(sort: Desc)])
  /// Дедупликация: одинаковый текст от одного автора среди живых объявлений.
  @@index([authorId, fingerprint])
}

/// Повторяемость события. Вхождения НЕ материализуются строками: правка
/// «воскресной программы» превратилась бы в правку сотни записей, а календарь
/// — в генератор мусора. Повторы разворачиваются в приложении,
/// notice-event-occurrences.ts.
///
/// `ekadashi` стоит особняком: лунный календарь правилом не выражается,
/// даты берутся таблицей из prisma/../notices/ekadashi-dates.ts.
enum NoticeRecurrence {
  none
  weekly
  biweekly
  monthly
  ekadashi
}

enum NoticeResponseStatus {
  open
  accepted
  declined
  withdrawn
}

/// `commercial` — отдельная причина, а не «другое»: дрейф в Рынок это
/// главный способ, которым некоммерческая доска перестаёт быть таковой,
/// и в очереди модератора его надо видеть отдельной строкой.
enum NoticeReportReason {
  spam
  commercial
  mlm
  duplicate
  scam
  inappropriate_content
  wrong_rubric
  other
}

enum NoticeReportStatus {
  open
  reviewed
  dismissed
}

/// Отклик. Одно сообщение и статус, а не переписка: своего чата у сервиса
/// нет, а импортировать чат Union запрещено контрактом. Пара (объявление,
/// человек) уникальна — второй отклик на то же объявление это правка первого.
model NoticeResponse {
  id       String               @id @default(uuid())
  noticeId String
  notice   Notice               @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  userId   String
  user     User                 @relation("NoticeResponsesMade", fields: [userId], references: [id], onDelete: Cascade)
  message  String?
  status   NoticeResponseStatus @default(open)

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([noticeId, userId])
  @@index([noticeId, status, createdAt])
  @@index([userId, createdAt(sort: Desc)])
}

/// Благодарность вместо рейтинга. Звёзды здесь были бы чужеродны: человек
/// отдал вещь даром, а ему ставят четвёрку. Благодарность нельзя занизить —
/// её либо сказали, либо нет, и отрицательной части у неё нет намеренно.
model NoticeThanks {
  id         String   @id @default(uuid())
  noticeId   String
  notice     Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation("NoticeThanksGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("NoticeThanksReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  note       String?
  createdAt  DateTime @default(now())

  @@unique([noticeId, fromUserId])
  @@index([toUserId, createdAt(sort: Desc)])
}

/// Жалоба на объявление. Своя таблица, а не портальный `UserReport`: цель —
/// объявление, а не пользователь.
model NoticeReport {
  id         String @id @default(uuid())
  reporterId String
  reporter   User   @relation("NoticeReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  noticeId   String
  notice     Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  reason        NoticeReportReason
  note          String?
  status        NoticeReportStatus @default(open)
  reviewedById  String?
  reviewedBy    User?              @relation("NoticeReportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  moderatorNote String?
  createdAt     DateTime           @default(now())

  /// Один человек жалуется на объявление один раз. В отличие от Рынка,
  /// отдельный `targetKey` не нужен: цель здесь всегда одна и не бывает NULL.
  @@unique([reporterId, noticeId])
  @@index([status, createdAt])
  @@index([noticeId])
}

enum NoticeSubscriptionKind {
  rubric
  city
  community
}

/// Подписка «сообщать о новом». Без неё доску открывают раз в месяц.
///
/// `targetKey` материализован отдельной колонкой по той же причине, что в
/// `MarketSubscription`: уникальный индекс по колонкам с NULL в Postgres не
/// дедуплицирует, и один человек мог бы подписаться на одну рубрику дважды.
model NoticeSubscription {
  id     String                 @id @default(uuid())
  userId String
  user   User                   @relation("NoticeSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  kind   NoticeSubscriptionKind

  targetKey   String
  rubricId    String?
  rubric      NoticeRubric? @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  /// Город строкой: справочника городов нет, нормализация — lower(trim()),
  /// как и в фильтрах ленты.
  city        String?
  communityId String?
  community   Community?    @relation("NoticeSubscriptions", fields: [communityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, targetKey])
  @@index([kind, targetKey])
  @@index([userId, createdAt(sort: Desc)])
}

/// Фото объявления. Публичные объекты в S3 — карточка попадает в SSR-HTML
/// и должна кешироваться CDN, поэтому не пресайн, как в галерее профиля.
model NoticeImage {
  id         String   @id @default(uuid())
  noticeId   String
  notice     Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  storageKey String   @unique
  url        String
  width      Int
  height     Int
  sizeBytes  Int
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([noticeId, sortOrder])
}
