generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
  service_admin
}

enum Gender {
  male
  female
}

// Режим биллинга платформы. beta — доступ бесплатный для всех, business — обычная логика тарифа.
enum BillingMode {
  beta
  business
}

enum ServiceStatus {
  active
  coming_soon
  disabled
}

enum SpiritualStage {
  seeker
  practitioner
  yogi
  devotee
}

enum DevoteeVerificationStatus {
  self_identified
  awaiting_mentor
  mentor_submitted
  awaiting_admin
  confirmed
  rejected
  needs_clarification
}

enum StageChangeActor {
  system
  user
  admin
}

enum UserAccountStatus {
  active
  blocked
  deleted
}

enum SupportTicketStatus {
  open
  in_progress
  waiting_user
  resolved
  closed
}

enum SupportTicketCategory {
  billing
  account
  technical
  moderation
  partnership
  other
}

enum SupportTicketAuthor {
  user
  guest
  admin
}

enum GitabaseAnnotationKind {
  highlight
  note
}

enum VedabaseImportStatus {
  staging
  validated
  active
  failed
}

enum MotivationProfileType {
  user
  in_goodness
  yogi
  devotee
}

enum MotivationAudienceTrack {
  universal
  vaishnava
}

enum MotivationPostStatus {
  draft
  generating
  published
  failed
  hidden
}

enum MotivationAttributionKind {
  exact_quote
  faithful_paraphrase
  ai_reflection
}

enum MotivationReviewStatus {
  discovered
  source_verified
  text_review
  image_queued
  image_review
  published
  rejected
  failed
}

/// Жизненный цикл ролика, оживляющего иллюстрацию поста. Отдельно от
/// `reviewStatus`: видео — необязательное обогащение уже готового поста, и его
/// сбой не должен возвращать пост в очередь картинки.
enum MotivationVideoStatus {
  none
  queued
  running
  review
  ready
  failed
}

enum MotivationQuoteSourceType {
  vedamatch_library
  approved_web
  manual
}

enum MotivationTranslationKind {
  official
  vedamatch
}

enum MotivationVisualStyle {
  spiritual_watercolor
  cinematic_nature
  indian_miniature
  sacred_architecture
  minimal_symbolism
  warm_documentary
  cosmic_contemplation
  historical_editorial
  /// Кинематографические стили. Заведены отдельно от рисовальных: у них другое
  /// начало промпта — «кадр из фильма», а не «нарисуй», — и без этого модель
  /// возвращалась к иллюстрации, какой бы стиль ни выбрали.
  cinematic_film
  epic_wide
  night_devotional
  painterly_realism
}

model User {
  id                           String                     @id @default(uuid())
  email                        String                     @unique
  // Обычное (мирское) имя. Остаётся обязательным: оно приходит из OAuth и
  // видно администрации, даже если человек подписан духовным именем.
  name                         String
  // Духовное имя. Если заполнено — именно оно показывается другим людям
  // во всём портале, см. resolveDisplayName в @vedamatch/shared.
  spiritualName                String?
  avatarUrl                    String?
  avatarKey                    String?
  // Дата рождения; наружу отдаётся только вычисленный возраст
  birthDate                    DateTime?                  @db.Date
  // Пол. Необязателен: у существующих аккаунтов его нет, и указывать никто не обязан.
  gender                       Gender?
  homeLocation                 Json?
  socialLinks                  Json?
  messengers                   Json?
  role                         Role                       @default(user)
  googleId                     String?                    @unique
  // scrypt-хеш пароля. Используется только dev-входом (DEV_AUTH_ENABLED).
  passwordHash                 String?
  // Помечает демо-аккаунты из dev-сида, чтобы их можно было пересоздать.
  isDemo                       Boolean                    @default(false)
  spiritualStage               SpiritualStage?
  devoteeVerificationStatus    DevoteeVerificationStatus?
  lastSelfIdentificationAt     DateTime?
  // Последняя активность; наружу отдаётся огрублённой (UnionActivityLevel)
  lastSeenAt                   DateTime?
  // Администрация сверила публичные фото с живым человеком
  photoVerifiedAt              DateTime?
  photoVerificationRequestedAt DateTime?
  // Подписка: пробный период считается от trialEndsAt (бэкфилл createdAt + 30 дней),
  // платный доступ — от subscriptionPaidUntil, который проставляет администратор.
  trialEndsAt                  DateTime?
  subscriptionPaidUntil        DateTime?
  subscriptionNote             String?
  // Блокировка/удаление аккаунта. Переходы по времени (конец блокировки, истечение
  // окна отмены удаления) финализируются лениво — см. account-status.ts.
  accountStatus                UserAccountStatus          @default(active)
  statusReason                 String?
  statusActor                  StageChangeActor?
  statusChangedAt              DateTime?
  blockedUntil                 DateTime?
  // Запрошено пользователем самостоятельное удаление; финализируется через SELF_DELETE_GRACE_DAYS.
  pendingDeletionAt            DateTime?
  deletedAt                    DateTime?
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt

  refreshTokens                      RefreshToken[]
  serviceAccess                      ServiceAccess[]
  serviceAdminScopes                 ServiceAdmin[]
  loginAudits                        LoginAudit[]
  pushSubscriptions                  PushSubscription[]
  astroBirthData                     AstroBirthData?
  astroUsage                         AstroUsage[]
  astroCompatibilityRequestsSent     AstroCompatibilityRequest[]  @relation("AstroCompatibilityRequester")
  astroCompatibilityRequestsReceived AstroCompatibilityRequest[]  @relation("AstroCompatibilityTarget")
  notificationPreference             NotificationPreference?
  notificationItems                  NotificationItem[]
  notificationBroadcasts             NotificationBroadcast[]      @relation("NotificationBroadcastsCreated")
  adminAuditEntries                  AdminAuditEntry[]            @relation("AdminAuditEntries")
  selfIdentificationResponses        SelfIdentificationResponse[]
  stageHistory                       StageHistory[]
  mentorVerificationRequests         MentorVerificationRequest[]
  unionProfile                       UnionProfile?
  unionRequestsSent                  UnionConnectionRequest[]     @relation("UnionRequestsSent")
  unionRequestsReceived              UnionConnectionRequest[]     @relation("UnionRequestsReceived")
  unionBoosts                        UnionBoost[]                 @relation("UnionBoosts")
  unionSwipesMade                    UnionSwipe[]                 @relation("UnionSwipesMade")
  unionSwipesReceived                UnionSwipe[]                 @relation("UnionSwipesReceived")
  unionChatMessagesSent              UnionChatMessage[]           @relation("UnionChatMessagesSent")
  unionMessageReactions              UnionMessageReaction[]       @relation("UnionMessageReactionsMade")
  photos                             UserPhoto[]
  blocksMade                         UserBlock[]                  @relation("UserBlocksMade")
  blocksReceived                     UserBlock[]                  @relation("UserBlocksReceived")
  hiddenFromOthers                   UserHiddenFrom[]             @relation("UserHiddenOwner")
  hiddenOthers                       UserHiddenFrom[]             @relation("UserHiddenViewer")
  contactsProfile                    ContactsProfile?
  contactsRequestsSent               ContactsRequest[]            @relation("ContactsRequestsSent")
  contactsRequestsReceived           ContactsRequest[]            @relation("ContactsRequestsReceived")
  contactsDisclosuresGranted         ContactsDisclosure[]         @relation("ContactsDisclosuresGranted")
  contactsDisclosuresReceived        ContactsDisclosure[]         @relation("ContactsDisclosuresReceived")
  reportsMade                        UserReport[]                 @relation("UserReportsMade")
  reportsReceived                    UserReport[]                 @relation("UserReportsReceived")
  reportsReviewed                    UserReport[]                 @relation("UserReportsReviewed")
  gitabaseReadingProgress            GitabaseReadingProgress[]
  gitabaseBookmarks                  GitabaseBookmark[]
  gitabaseAnnotations                GitabaseAnnotation[]
  gitabaseSyncMutations              GitabaseSyncMutation[]
  motivationPreference               MotivationPreference?
  motivationFavorites                MotivationFavorite[]
  motivationViews                    MotivationView[]
  motivationModerationAudits         MotivationModerationAudit[]
  motivationAuthorWatches            MotivationAuthorWatch[]
  motivationSourceWatches            MotivationSourceWatch[]
  supportTickets                     SupportTicket[]              @relation("SupportTicketsOwned")
  supportTicketsAssigned             SupportTicket[]              @relation("SupportTicketsAssigned")
  supportTicketMessages              SupportTicketMessage[]       @relation("SupportTicketMessagesAuthored")
  libraryCategories                  LibraryCategory[]            @relation("LibraryCategoryAuthor")
  libraryEntries                     LibraryEntry[]               @relation("LibraryEntryAuthor")
  libraryPreference                  LibraryPreference?
  libraryBookmarks                   LibraryBookmark[]
  libraryComments                    LibraryComment[]
  astroTransitDigests                AstroTransitDigest[]
  marketShop                         MarketShop?                  @relation("MarketShopOwner")
  marketFavorites                    MarketFavorite[]
  marketPreference                   MarketPreference?
  marketCartItems                    MarketCartItem[]
  marketOrders                       MarketOrder[]                @relation("MarketOrdersPlaced")
  marketConversations                MarketConversation[]         @relation("MarketConversationsAsBuyer")
  marketMessagesSent                 MarketMessage[]              @relation("MarketMessagesSent")
  marketReviews                      MarketReview[]               @relation("MarketReviewsWritten")
  marketComments                     MarketListingComment[]       @relation("MarketCommentsWritten")
  marketSubscriptions                MarketSubscription[]
  marketReportsMade                  MarketReport[]               @relation("MarketReportsMade")
  marketReportsReviewed              MarketReport[]               @relation("MarketReportsReviewed")
  communitiesCreated                 Community[]                  @relation("CommunityCreatedBy")
  communitiesVerified                Community[]                  @relation("CommunityVerifiedBy")
  communityMemberships               CommunityMember[]            @relation("CommunityMemberships")
  communityMemberDecisions           CommunityMember[]            @relation("CommunityMemberDecidedBy")
  communityTransfersSent             CommunityOwnershipTransfer[] @relation("CommunityTransfersSent")
  communityTransfersReceived         CommunityOwnershipTransfer[] @relation("CommunityTransfersReceived")
  notices                            Notice[]                     @relation("NoticesAuthored")
  noticeResponses                    NoticeResponse[]             @relation("NoticeResponsesMade")
  noticeThanksGiven                  NoticeThanks[]               @relation("NoticeThanksGiven")
  noticeThanksReceived               NoticeThanks[]               @relation("NoticeThanksReceived")
  noticeReportsMade                  NoticeReport[]               @relation("NoticeReportsMade")
  noticeReportsReviewed              NoticeReport[]               @relation("NoticeReportsReviewed")
  noticeSubscriptions                NoticeSubscription[]         @relation("NoticeSubscriptions")
  motivationTracks                   MotivationTrack[]

  @@index([accountStatus])
  @@index([birthDate])
}

// Единственная строка глобальных настроек платформы (id всегда "global").
model AppSettings {
  id          String      @id @default("global")
  billingMode BillingMode @default(business)
  updatedAt   DateTime    @updatedAt
}

model UserPhoto {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey String   @unique
  sizeBytes  Int
  width      Int
  height     Int
  isPublic   Boolean  @default(false)
  sortOrder  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, sortOrder, createdAt])
  @@index([userId, isPublic, sortOrder])
}

model MotivationQuote {
  id                  String                       @id @default(uuid())
  originalText        String
  normalizedHash      String                       @unique
  originalLanguage    String                       @db.VarChar(8)
  author              String
  work                String
  locator             String
  sourceType          MotivationQuoteSourceType
  sourceUrl           String?
  vedabaseBookSlug    String?
  vedabaseChapterSlug String?
  contextExcerpt      String
  verified            Boolean                      @default(false)
  verifiedAt          DateTime?
  discoveryDate       DateTime?                    @db.Date
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  translations        MotivationQuoteTranslation[]
  profiles            MotivationQuoteProfile[]
  posts               MotivationPost[]

  @@index([verified, createdAt])
  @@index([sourceType, verified])
  @@index([discoveryDate, verified])
}

model MotivationQuoteTranslation {
  id              String                    @id @default(uuid())
  quoteId         String
  quote           MotivationQuote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  language        String                    @db.VarChar(8)
  quoteText       String
  translationKind MotivationTranslationKind
  label           String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([quoteId, language])
  @@index([language])
}

model MotivationQuoteProfile {
  quoteId     String
  quote       MotivationQuote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  profileType MotivationProfileType
  createdAt   DateTime              @default(now())

  @@id([quoteId, profileType])
  @@index([profileType])
}

model MotivationPost {
  id                   String                    @id @default(uuid())
  contentDate          DateTime                  @db.Date
  profileType          MotivationProfileType
  audienceTrack        MotivationAudienceTrack
  slug                 String                    @unique
  category             String
  quoteId              String?                   @unique
  quote                MotivationQuote?          @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  status               MotivationPostStatus      @default(draft)
  reviewStatus         MotivationReviewStatus    @default(discovered)
  visualStyle          MotivationVisualStyle?
  imagePrompt          String?
  /// Отметка о том, что промпт правил человек. Нужна перегенерации: без неё
  /// повторный заказ картинки пересобирал бы черновик заново и молча стирал
  /// правку, ради которой администратор его и открывал.
  imagePromptEditedAt  DateTime?
  /// Промпт для видеомодели. Отдельно от `imagePrompt`, потому что описывает
  /// не сцену, а движение в ней: описание статичного кадра видеомодель
  /// понимает как «сделай ещё раз то же самое» и выдаёт мёртвый ролик.
  /// Пусто — берётся общий дефолт из `video-prompt.ts`.
  videoPrompt          String?
  textApprovedAt       DateTime?
  imageApprovedAt      DateTime?
  imageUrl             String?
  storyImageUrl        String?
  /// Ролик, оживляющий иллюстрацию. Появляется по кнопке в админке уже после
  /// одобрения картинки, поэтому все поля необязательные.
  videoUrl             String?
  videoStatus          MotivationVideoStatus     @default(none)
  /// Идентификатор задачи у провайдера: генерация асинхронная, воркер
  /// возвращается за результатом следующим тиком. По нему же сверяются строки
  /// счёта в кабинете fal — там расход разложен по request id.
  videoJobId           String?
  /// Ссылки на статус и результат берём те, что прислал провайдер: собирать их
  /// из имени модели нельзя, база у него не совпадает с путём модели.
  videoJobStatusUrl    String?
  videoJobResultUrl    String?
  /// Читать ли цитату голосом. Выключено по умолчанию: машинное чтение
  /// писания — решение редакции, а не побочный эффект включённой генерации.
  videoVoice           Boolean                   @default(false)
  /// Длина ролика в секундах. Пусто — считаем сами: по озвучке, если она есть,
  /// иначе по времени чтения подписи. Модель отдаёт пять секунд, остальное
  /// добирается повтором — растягивать генерацию втрое дороже.
  videoSeconds         Int?
  /// Голос озвучки. Пусто — берётся из настроек; проверяется по списку из
  /// `@vedamatch/shared`, чтобы опечатка не ушла в платный запрос.
  videoVoiceName       String?
  videoErrorCode       String?
  videoAttemptCount    Int                       @default(0)
  /// Стоимость ролика отдельно от `estimatedCostUsd`: без разбивки через месяц
  /// не понять, во что обошлось именно видео.
  videoCostUsd         Decimal                   @default(0) @db.Decimal(12, 6)
  attributionKind      MotivationAttributionKind @default(ai_reflection)
  attributionSpeaker   String?
  attributionWork      String?
  attributionLocator   String?
  attributionSourceUrl String?
  /// Накладывать ли цитату и подпись на кадр для Stories. Хранится, а не
  /// решается на лету: сторис собирает воркер уже после создания поста.
  storyCaption         Boolean                   @default(true)
  sourceVerified       Boolean                   @default(false)
  generationStage      String?
  generationErrorCode  String?
  promptVersion        String?
  modelVersion         String?
  attemptCount         Int                       @default(0)
  estimatedCostUsd     Decimal                   @default(0) @db.Decimal(12, 6)
  publishedAt          DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  translations     MotivationPostTranslation[]
  favorites        MotivationFavorite[]
  views            MotivationView[]
  moderationAudits MotivationModerationAudit[]

  @@index([profileType, audienceTrack, status, publishedAt])
  @@index([category, status, publishedAt])
  @@index([reviewStatus, createdAt])
  /// Воркер видео выбирает задачи по статусу — без индекса он сканировал бы
  /// всю таблицу постов на каждом тике.
  @@index([videoStatus, updatedAt])
  @@index([quoteId])
}

/// Единственная строка настроек сервиса (id всегда "global").
///
/// Всё, что раньше жило в `.env`, кроме секретов: модели меняются по несколько
/// раз за вечер, и каждый раз править файл с перезапуском — слишком дорого.
/// Пустое поле означает «взять из окружения», поэтому настройки можно вводить
/// постепенно, ничего не ломая.
model MotivationSettings {
  id             String                 @id @default("global")
  videoModel     String?
  videoSeconds   Int?
  videoAudio     Boolean?
  voiceModel     String?
  voiceName      String?
  imageModel     String?
  /// Стиль по умолчанию. Пусто — подбирать автоматически по смыслу и источнику.
  visualStyle    MotivationVisualStyle?
  /// Дневной потолок расхода в долларах. Меняться должен без перевыкладки.
  dailyBudgetUsd Decimal?               @db.Decimal(10, 2)
  musicModel     String?
  /// Трек по умолчанию. Пусто — ролики выходят без подложки.
  defaultTrackId String?
  updatedAt      DateTime               @updatedAt
}

/// Трек музыкальной подложки.
///
/// Генерируется один раз и переиспользуется во множестве роликов: клип длится
/// секунды, а трек — полминуты, поэтому платить за музыку под каждый пост
/// незачем. Человек прослушивает и принимает трек до того, как он попадёт в
/// ленту, — та же проверка, что и у картинки с озвучкой.
model MotivationTrack {
  id          String                @id @default(uuid())
  title       String
  /// Промпт, которым трек создан: по нему понятно, что переслушивать и что
  /// править, если захочется похожий.
  prompt      String
  url         String
  seconds     Int
  status      MotivationTrackStatus @default(draft)
  model       String
  costUsd     Decimal               @default(0) @db.Decimal(10, 4)
  createdById String
  createdBy   User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime              @default(now())

  @@index([status, createdAt])
}

enum MotivationTrackStatus {
  draft
  approved
  rejected
}

/// Справочник категорий Motivation. `MotivationPost.category` хранит `slug`
/// строкой, а не FK: так сохраняются индекс `[category, status, publishedAt]`
/// и фильтр ленты `?category=`, а удаление категории не трогает посты.
///
/// Вложенность ровно в два уровня: у подкатегории `parentId` указывает на
/// категорию верхнего уровня, у которой `parentId` всегда null. Глубже нельзя —
/// правило держит `MotivationCategoriesService`.
model MotivationCategory {
  id        String               @id @default(uuid())
  slug      String               @unique
  title     String
  sortOrder Int                  @default(0)
  isDefault Boolean              @default(false)
  parentId  String?
  parent    MotivationCategory?  @relation("MotivationCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  MotivationCategory[] @relation("MotivationCategoryTree")
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([sortOrder])
  @@index([parentId])
}

model MotivationModerationAudit {
  id        String         @id @default(uuid())
  postId    String
  post      MotivationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  reason    String?
  metadata  Json?
  createdAt DateTime       @default(now())

  @@index([postId, createdAt])
  @@index([actorId, createdAt])
}

model MotivationPostTranslation {
  id        String         @id @default(uuid())
  postId    String
  post      MotivationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  language  String         @db.VarChar(8)
  title     String
  text      String
  storyText String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([postId, language])
  @@index([language])
}

model MotivationPreference {
  userId           String                  @id
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaishnavaPercent Int                     @default(50)
  language         String                  @default("ru") @db.VarChar(8)
  /// Какие профили показывать в ленте. Пустой список — «как на
  /// самоидентификации»: так у прежних пользователей ничего не меняется без
  /// бэкфила, а осознанный выбор отличим от его отсутствия.
  profileTypes     MotivationProfileType[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
}

model MotivationFavorite {
  userId    String
  postId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      MotivationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@id([userId, postId])
  @@index([userId, createdAt])
}

model MotivationView {
  userId   String
  postId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  post     MotivationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  viewedAt DateTime       @default(now())

  @@id([userId, postId])
  @@index([userId, viewedAt])
}

model MotivationAuthorWatch {
  id              String    @id @default(uuid())
  name            String
  language        String?   @db.VarChar(8)
  enabled         Boolean   @default(true)
  createdById     String?
  createdBy       User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  lastSearchedAt  DateTime?
  lastResultCount Int       @default(0)

  @@unique([name])
}

model MotivationSourceWatch {
  id              String    @id @default(uuid())
  url             String
  label           String?
  enabled         Boolean   @default(true)
  createdById     String?
  createdBy       User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  lastFetchedAt   DateTime?
  lastResultCount Int       @default(0)

  @@unique([url])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  // Под чистку протухших/отозванных (RefreshTokenCleanupService).
  @@index([expiresAt])
  @@index([revoked, createdAt])
}

model Service {
  id                           String        @id @default(uuid())
  slug                         String        @unique
  name                         String
  description                  String
  iconUrl                      String?
  url                          String
  status                       ServiceStatus @default(coming_soon)
  category                     String
  /// Порядок в сетке портала. Меньше — выше; при равенстве сортировка по имени.
  sortOrder                    Int           @default(0)
  // null/true = СЃРµСЂРІРёСЃ РґРѕСЃС‚СѓРїРµРЅ РІСЃРµРј Р°РІС‚РѕСЂРёР·РѕРІР°РЅРЅС‹Рј; РёРЅР°С‡Рµ РґРѕСЃС‚СѓРї С‡РµСЂРµР· ServiceAccess/СЂРѕР»СЊ/СЌС‚Р°Рї РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ
  public                       Boolean       @default(true)
  seekerVisible                Boolean       @default(true)
  practitionerVisible          Boolean       @default(true)
  yogiVisible                  Boolean       @default(true)
  devoteeSelfIdentifiedVisible Boolean       @default(false)
  devoteeVerifiedVisible       Boolean       @default(false)
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt

  access ServiceAccess[]
  admins ServiceAdmin[]
}

// Сервисы, которыми управляет аккаунт с ролью service_admin. Роль admin
// эту таблицу игнорирует — у неё доступ ко всему порталу.
model ServiceAdmin {
  userId    String
  serviceId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([userId, serviceId])
  @@index([serviceId])
}

model ServiceAccess {
  userId    String
  serviceId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([userId, serviceId])
}

/// Журнал действий администрации: кто, что и над кем сделал. Пишется
/// подписчиком на событие `admin.action` — так модуль-издатель не зависит от
/// журнала, а сервисные модули не нарушают контракт, импортируя чужой сервис.
///
/// Модерация Motivation ведёт свой журнал (MotivationModerationAudit): он
/// привязан к посту и живёт вместе с ним, дублировать его сюда незачем.
model AdminAuditEntry {
  id         String   @id @default(uuid())
  /// Автор действия. null — аккаунт администратора удалён; запись остаётся.
  actorId    String?
  actor      User?    @relation("AdminAuditEntries", fields: [actorId], references: [id], onDelete: SetNull)
  /// Что произошло: значение AdminAuditAction из @vedamatch/shared.
  action     String
  /// Над чем: тип объекта и его id. `platform` — действие над всем порталом.
  targetType String
  targetId   String?
  /// Подробности для строки журнала: было/стало, причина.
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([action, createdAt(sort: Desc)])
}

model LoginAudit {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model SelfIdentificationResponse {
