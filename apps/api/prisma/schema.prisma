generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
  service_admin
}

enum Gender {
  male
  female
}

// Режим биллинга платформы. beta — доступ бесплатный для всех, business — обычная логика тарифа.
enum BillingMode {
  beta
  business
}

enum ServiceStatus {
  active
  coming_soon
  disabled
}

enum SpiritualStage {
  seeker
  practitioner
  yogi
  devotee
}

enum DevoteeVerificationStatus {
  self_identified
  awaiting_mentor
  mentor_submitted
  awaiting_admin
  confirmed
  rejected
  needs_clarification
}

enum StageChangeActor {
  system
  user
  admin
}

enum SupportTicketStatus {
  open
  in_progress
  waiting_user
  resolved
  closed
}

enum SupportTicketCategory {
  billing
  account
  technical
  moderation
  partnership
  other
}

enum SupportTicketAuthor {
  user
  guest
  admin
}

enum GitabaseAnnotationKind {
  highlight
  note
}

enum VedabaseImportStatus {
  staging
  validated
  active
  failed
}

enum MotivationProfileType {
  user
  in_goodness
  yogi
  devotee
}

enum MotivationAudienceTrack {
  universal
  vaishnava
}

enum MotivationPostStatus {
  draft
  generating
  published
  failed
  hidden
}

enum MotivationAttributionKind {
  exact_quote
  faithful_paraphrase
  ai_reflection
}

enum MotivationReviewStatus {
  discovered
  source_verified
  text_review
  image_queued
  image_review
  published
  rejected
  failed
}

enum MotivationQuoteSourceType {
  vedamatch_library
  approved_web
  manual
}

enum MotivationTranslationKind {
  official
  vedamatch
}

enum MotivationVisualStyle {
  spiritual_watercolor
  cinematic_nature
  indian_miniature
  sacred_architecture
  minimal_symbolism
  warm_documentary
  cosmic_contemplation
  historical_editorial
}

model User {
  id                           String                     @id @default(uuid())
  email                        String                     @unique
  name                         String
  avatarUrl                    String?
  avatarKey                    String?
  // Дата рождения; наружу отдаётся только вычисленный возраст
  birthDate                    DateTime?                  @db.Date
  // Пол. Необязателен: у существующих аккаунтов его нет, и указывать никто не обязан.
  gender                       Gender?
  homeLocation                 Json?
  socialLinks                  Json?
  messengers                   Json?
  role                         Role                       @default(user)
  googleId                     String?                    @unique
  // scrypt-хеш пароля. Используется только dev-входом (DEV_AUTH_ENABLED).
  passwordHash                 String?
  // Помечает демо-аккаунты из dev-сида, чтобы их можно было пересоздать.
  isDemo                       Boolean                    @default(false)
  spiritualStage               SpiritualStage?
  devoteeVerificationStatus    DevoteeVerificationStatus?
  lastSelfIdentificationAt     DateTime?
  // Последняя активность; наружу отдаётся огрублённой (UnionActivityLevel)
  lastSeenAt                   DateTime?
  // Администрация сверила публичные фото с живым человеком
  photoVerifiedAt              DateTime?
  photoVerificationRequestedAt DateTime?
  // Подписка: пробный период считается от trialEndsAt (бэкфилл createdAt + 30 дней),
  // платный доступ — от subscriptionPaidUntil, который проставляет администратор.
  trialEndsAt                  DateTime?
  subscriptionPaidUntil        DateTime?
  subscriptionNote             String?
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt

  refreshTokens                      RefreshToken[]
  serviceAccess                      ServiceAccess[]
  loginAudits                        LoginAudit[]
  pushSubscriptions                  PushSubscription[]
  astroBirthData                     AstroBirthData?
  astroUsage                         AstroUsage[]
  astroCompatibilityRequestsSent     AstroCompatibilityRequest[]  @relation("AstroCompatibilityRequester")
  astroCompatibilityRequestsReceived AstroCompatibilityRequest[]  @relation("AstroCompatibilityTarget")
  notificationPreference             NotificationPreference?
  selfIdentificationResponses        SelfIdentificationResponse[]
  stageHistory                       StageHistory[]
  mentorVerificationRequests         MentorVerificationRequest[]
  unionProfile                       UnionProfile?
  unionRequestsSent                  UnionConnectionRequest[]     @relation("UnionRequestsSent")
  unionRequestsReceived              UnionConnectionRequest[]     @relation("UnionRequestsReceived")
  unionBoosts                        UnionBoost[]                 @relation("UnionBoosts")
  unionSwipesMade                    UnionSwipe[]                 @relation("UnionSwipesMade")
  unionSwipesReceived                UnionSwipe[]                 @relation("UnionSwipesReceived")
  unionChatMessagesSent              UnionChatMessage[]           @relation("UnionChatMessagesSent")
  unionMessageReactions              UnionMessageReaction[]       @relation("UnionMessageReactionsMade")
  photos                             UserPhoto[]
  blocksMade                         UserBlock[]                  @relation("UserBlocksMade")
  blocksReceived                     UserBlock[]                  @relation("UserBlocksReceived")
  reportsMade                        UserReport[]                 @relation("UserReportsMade")
  reportsReceived                    UserReport[]                 @relation("UserReportsReceived")
  reportsReviewed                    UserReport[]                 @relation("UserReportsReviewed")
  gitabaseReadingProgress            GitabaseReadingProgress[]
  gitabaseBookmarks                  GitabaseBookmark[]
  gitabaseAnnotations                GitabaseAnnotation[]
  gitabaseSyncMutations              GitabaseSyncMutation[]
  motivationPreference               MotivationPreference?
  motivationFavorites                MotivationFavorite[]
  motivationViews                    MotivationView[]
  motivationModerationAudits         MotivationModerationAudit[]
  motivationAuthorWatches            MotivationAuthorWatch[]
  motivationSourceWatches            MotivationSourceWatch[]
  supportTickets                     SupportTicket[]              @relation("SupportTicketsOwned")
  supportTicketsAssigned             SupportTicket[]              @relation("SupportTicketsAssigned")
  supportTicketMessages              SupportTicketMessage[]       @relation("SupportTicketMessagesAuthored")
  libraryCategories                  LibraryCategory[]            @relation("LibraryCategoryAuthor")
  libraryEntries                     LibraryEntry[]               @relation("LibraryEntryAuthor")
  libraryPreference                  LibraryPreference?
  libraryBookmarks                   LibraryBookmark[]
  libraryComments                    LibraryComment[]
  astroTransitDigests                AstroTransitDigest[]
}

// Единственная строка глобальных настроек платформы (id всегда "global").
model AppSettings {
  id          String      @id @default("global")
  billingMode BillingMode @default(business)
  updatedAt   DateTime    @updatedAt
}

model UserPhoto {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey String   @unique
  sizeBytes  Int
  width      Int
  height     Int
  isPublic   Boolean  @default(false)
  sortOrder  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, sortOrder, createdAt])
  @@index([userId, isPublic, sortOrder])
}

model MotivationQuote {
  id                  String                       @id @default(uuid())
  originalText        String
  normalizedHash      String                       @unique
  originalLanguage    String                       @db.VarChar(8)
  author              String
  work                String
  locator             String
  sourceType          MotivationQuoteSourceType
  sourceUrl           String?
  vedabaseBookSlug    String?
  vedabaseChapterSlug String?
  contextExcerpt      String
  verified            Boolean                      @default(false)
  verifiedAt          DateTime?
  discoveryDate       DateTime?                    @db.Date
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  translations        MotivationQuoteTranslation[]
  profiles            MotivationQuoteProfile[]
  posts               MotivationPost[]

  @@index([verified, createdAt])
  @@index([sourceType, verified])
  @@index([discoveryDate, verified])
}

model MotivationQuoteTranslation {
  id              String                    @id @default(uuid())
  quoteId         String
  quote           MotivationQuote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  language        String                    @db.VarChar(8)
  quoteText       String
  translationKind MotivationTranslationKind
  label           String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([quoteId, language])
  @@index([language])
}

model MotivationQuoteProfile {
  quoteId     String
  quote       MotivationQuote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  profileType MotivationProfileType
  createdAt   DateTime              @default(now())

  @@id([quoteId, profileType])
  @@index([profileType])
}

model MotivationPost {
  id                   String                    @id @default(uuid())
  contentDate          DateTime                  @db.Date
  profileType          MotivationProfileType
  audienceTrack        MotivationAudienceTrack
  slug                 String                    @unique
  category             String
  quoteId              String?                   @unique
  quote                MotivationQuote?          @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  status               MotivationPostStatus      @default(draft)
  reviewStatus         MotivationReviewStatus    @default(discovered)
  visualStyle          MotivationVisualStyle?
  imagePrompt          String?
  textApprovedAt       DateTime?
  imageApprovedAt      DateTime?
  imageUrl             String?
  storyImageUrl        String?
  attributionKind      MotivationAttributionKind @default(ai_reflection)
  attributionSpeaker   String?
  attributionWork      String?
  attributionLocator   String?
  attributionSourceUrl String?
  sourceVerified       Boolean                   @default(false)
  generationStage      String?
  generationErrorCode  String?
  promptVersion        String?
  modelVersion         String?
  attemptCount         Int                       @default(0)
  estimatedCostUsd     Decimal                   @default(0) @db.Decimal(12, 6)
  publishedAt          DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  translations     MotivationPostTranslation[]
  favorites        MotivationFavorite[]
  views            MotivationView[]
  moderationAudits MotivationModerationAudit[]

  @@index([profileType, audienceTrack, status, publishedAt])
  @@index([category, status, publishedAt])
  @@index([reviewStatus, createdAt])
  @@index([quoteId])
}

model MotivationModerationAudit {
  id        String         @id @default(uuid())
  postId    String
  post      MotivationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String
  reason    String?
  metadata  Json?
  createdAt DateTime       @default(now())

  @@index([postId, createdAt])
  @@index([actorId, createdAt])
}

model MotivationPostTranslation {
  id        String         @id @default(uuid())
  postId    String
  post      MotivationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  language  String         @db.VarChar(8)
  title     String
  text      String
  storyText String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([postId, language])
  @@index([language])
}

model MotivationPreference {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaishnavaPercent Int      @default(50)
  language         String   @default("ru") @db.VarChar(8)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MotivationFavorite {
  userId    String
  postId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      MotivationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@id([userId, postId])
  @@index([userId, createdAt])
}

model MotivationView {
  userId   String
  postId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  post     MotivationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  viewedAt DateTime       @default(now())

  @@id([userId, postId])
  @@index([userId, viewedAt])
}

model MotivationAuthorWatch {
  id              String    @id @default(uuid())
  name            String
  language        String?   @db.VarChar(8)
  enabled         Boolean   @default(true)
  createdById     String
  createdBy       User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime  @default(now())
  lastSearchedAt  DateTime?
  lastResultCount Int       @default(0)

  @@unique([name])
}

model MotivationSourceWatch {
  id              String    @id @default(uuid())
  url             String
  label           String?
  enabled         Boolean   @default(true)
  createdById     String
  createdBy       User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime  @default(now())
  lastFetchedAt   DateTime?
  lastResultCount Int       @default(0)

  @@unique([url])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Service {
  id                           String        @id @default(uuid())
  slug                         String        @unique
  name                         String
  description                  String
  iconUrl                      String?
  url                          String
  status                       ServiceStatus @default(coming_soon)
  category                     String
  // null/true = СЃРµСЂРІРёСЃ РґРѕСЃС‚СѓРїРµРЅ РІСЃРµРј Р°РІС‚РѕСЂРёР·РѕРІР°РЅРЅС‹Рј; РёРЅР°С‡Рµ РґРѕСЃС‚СѓРї С‡РµСЂРµР· ServiceAccess/СЂРѕР»СЊ/СЌС‚Р°Рї РїРѕР»СЊР·РѕРІР°С‚РµР»СЏ
  public                       Boolean       @default(true)
  seekerVisible                Boolean       @default(true)
  practitionerVisible          Boolean       @default(true)
  yogiVisible                  Boolean       @default(true)
  devoteeSelfIdentifiedVisible Boolean       @default(false)
  devoteeVerifiedVisible       Boolean       @default(false)
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt

  access ServiceAccess[]
}

model ServiceAccess {
  userId    String
  serviceId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([userId, serviceId])
}

model LoginAudit {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model SelfIdentificationResponse {
  id                 String                     @id @default(uuid())
  userId             String
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers            Json
  detectedStage      SpiritualStage
  verificationStatus DevoteeVerificationStatus?
  createdAt          DateTime                   @default(now())

  @@index([userId, createdAt])
}

model StageHistory {
  id                 String                     @id @default(uuid())
  userId             String
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  oldStage           SpiritualStage?
  newStage           SpiritualStage
  actor              StageChangeActor
  reason             String?
  answers            Json?
  verificationStatus DevoteeVerificationStatus?
  mentorRequestId    String?
  createdAt          DateTime                   @default(now())

  @@index([userId, createdAt])
}

model MentorVerificationRequest {
  id                          String                    @id @default(uuid())
  token                       String                    @unique
  userId                      String
  user                        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                      DevoteeVerificationStatus @default(awaiting_mentor)
  mentorName                  String?
  phone                       String?
  email                       String?
  cityOrCommunity             String?
  knownDuration               String?
  knowsPersonally             Boolean?
  confirmsRegularPractice     Boolean?
  confirmsService             Boolean?
  confirmsSpiritualName       Boolean?
  confirmsCommunityConnection Boolean?
  userCharacterReference      String?
  recommendsDevoteeStatus     Boolean?
  truthConsent                Boolean?
  mentorSubmittedAt           DateTime?
  adminNote                   String?
  adminReviewedAt             DateTime?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  @@index([userId, status])
}

// ===== Gitabase user state =====

model GitabaseReadingProgress {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookSlug   String
  locator    Json
  percentage Int
  lastReadAt DateTime @default(now())
  revision   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([userId, bookSlug])
  @@index([userId, updatedAt])
}

model GitabaseBookmark {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookSlug  String
  locator   Json
  label     String?
  revision  Int       @default(1)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, bookSlug])
  @@index([userId, updatedAt])
}

model GitabaseAnnotation {
  id        String                 @id
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookSlug  String
  kind      GitabaseAnnotationKind
  locator   Json
  range     Json
  color     String?
  noteText  String?
  revision  Int                    @default(1)
  deletedAt DateTime?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  revisions GitabaseAnnotationRevision[]

  @@index([userId, bookSlug])
  @@index([userId, updatedAt])
}

model GitabaseAnnotationRevision {
  id           String             @id @default(uuid())
  annotationId String
  annotation   GitabaseAnnotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  revision     Int
  noteText     String?
  createdAt    DateTime           @default(now())

  @@unique([annotationId, revision])
}

model GitabaseSyncMutation {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientMutationId String
  entity           String
  entityId         String
  revision         Int
  payload          Json
  createdAt        DateTime @default(now())

  @@unique([userId, clientMutationId])
  @@index([userId, createdAt, id])
}

// ===== Vedabase canonical content =====

model VedabaseBook {
  id              String                @id @default(uuid())
  slug            String                @unique
  title           String
  author          String?
  language        String
  cover           Json?
  sourceUrl       String
  attribution     String
  activeVersionId String?               @unique
  activeVersion   VedabaseBookVersion?  @relation("ActiveVedabaseVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions        VedabaseBookVersion[] @relation("VedabaseBookVersions")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model VedabaseBookVersion {
  id                  String               @id @default(uuid())
  bookId              String
  book                VedabaseBook         @relation("VedabaseBookVersions", fields: [bookId], references: [id], onDelete: Cascade)
  activeFor           VedabaseBook?        @relation("ActiveVedabaseVersion")
  contentVersion      String
  formatVersion       Int
  status              VedabaseImportStatus @default(staging)
  permissionRef       String
  attribution         String
  importedAt          DateTime
  sizeBytes           BigInt
  packageChecksum     String
  chapterCount        Int
  searchableUnitCount Int
  searchIndexBytes    Int
  searchIndexSha256   String
  coverBytes          Int?
  coverSha256         String?
  errorMessage        String?
  chapters            VedabaseChapter[]
  searchUnits         VedabaseSearchUnit[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([bookId, contentVersion])
  @@index([status, updatedAt])
}

model VedabaseChapter {
  id        String              @id @default(uuid())
  versionId String
  version   VedabaseBookVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  order     Int
  payload   Json
  bytes     Int
  sha256    String

  @@unique([versionId, slug])
  @@unique([versionId, order])
}

model VedabaseSearchUnit {
  id          String              @id @default(uuid())
  versionId   String
  version     VedabaseBookVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  chapterSlug String
  locator     Json
  title       String
  text        String

  @@index([versionId, chapterSlug])
}

// ===== Union service =====
// Модели сервиса VedaMatch Union. Связи только с User (read-only портальные данные).
// См. docs/service-module-contract.md

enum UnionIntentionType {
  family
  business
  friendship
  service
}

enum UnionConnectionStatus {
  pending
  accepted
  declined
  cancelled
}

enum UnionFormat {
  online
  offline
  any
}

/// Питание. Для вайшнавского контекста заменяет вопросы «алкоголь/курение» из массовых анкет.
enum UnionDiet {
  vegetarian
  vegan
  prasadam_only
  transitioning
  not_vegetarian
}

/// Четыре регулирующих принципа. Хранятся как набор соблюдаемых — «ничего не выбрано»
/// означает «не указано», а не «не соблюдаю ничего».
enum UnionRegulativePrinciple {
  no_meat
  no_intoxicants
  no_gambling
  no_illicit_sex
}

enum UnionChildrenStatus {
  none_want
  none_not_want
  none_undecided
  have_living_with
  have_living_apart
}

enum UnionEducationLevel {
  school
  vocational
  incomplete_higher
  higher
  academic_degree
}

enum UnionSpiritualEducation {
  none
  temple_courses
  bhakti_shastri
  bhakti_vaibhava
  bhakti_vedanta
  other
}

enum UnionHousing {
  own_place
  rent
  with_parents
  with_relatives
  community
  temple_ashram
}

/// Материальная обеспеченность. Формулировки намеренно мягкие, поле опционально
/// и закрывается настройками приватности.
enum UnionIncomeLevel {
  basic_needs_hard
  basic_needs
  basic_and_rest
  comfortable
  prefer_not_say
}

model UnionProfile {
  id                       String                     @id @default(uuid())
  userId                   String                     @unique
  user                     User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  about                    String?
  /// Короткая строка-статус поверх анкеты
  status                   String?
  relocationReady          Boolean                    @default(false)
  format                   UnionFormat                @default(any)
  languages                String[]                   @default([])
  skills                   String[]                   @default([])
  interests                String[]                   @default([])
  values                   String[]                   @default([])
  familyStatus             String?
  // Блок «О себе»: все поля опциональны
  heightCm                 Int?
  diet                     UnionDiet?
  regulativePrinciples     UnionRegulativePrinciple[] @default([])
  childrenStatus           UnionChildrenStatus?
  education                UnionEducationLevel?
  spiritualEducation       UnionSpiritualEducation?
  housing                  UnionHousing?
  income                   UnionIncomeLevel?
  pets                     String[]                   @default([])
  // Желаемый возраст партнёра; используется как фильтр рекомендаций
  ageRangeMin              Int?
  ageRangeMax              Int?
  // { photo, age, city, contacts: 'everyone' | 'after_match' | 'hidden' }
  privacy                  Json?
  // скрыть из рекомендаций без удаления профиля
  isActive                 Boolean                    @default(true)
  // принимать запросы на знакомство только от подтверждённых преданных
  requestsFromVerifiedOnly Boolean                    @default(false)
  /// Кто может начать общение: заявки от всех или только взаимные лайки
  contactMode              UnionContactMode           @default(requests)
  /// Кого искать при цели «Создание семьи». null — пол не важен. Работает
  /// в обе стороны и только пока цель «Создание семьи» отмечена.
  familySeeksGender        Gender?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  intentions UnionIntention[]
}

/// Режим знакомства. `requests` — односторонний лайк приходит как заявка,
/// человек отвечает вручную. `mutual_only` — заявка создаётся только когда
/// лайк взаимный, односторонние интересующиеся не показываются.
enum UnionContactMode {
  requests
  mutual_only
}

enum UnionSwipeDecision {
  like
  superlike
  pass
}

/// Буст «Внимание»: пока не истёк, анкета идёт первой в чужих рекомендациях.
model UnionBoost {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UnionBoosts", fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

/// Решение по анкете в колоде. Хранится, чтобы пропущенные не возвращались
/// в выдачу и чтобы работал откат последнего свайпа.
model UnionSwipe {
  id         String             @id @default(uuid())
  fromUserId String
  fromUser   User               @relation("UnionSwipesMade", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User               @relation("UnionSwipesReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  decision   UnionSwipeDecision
  createdAt  DateTime           @default(now())
  /// Момент отката. Откатанный свайп не влияет на выдачу.
  undoneAt   DateTime?

  @@unique([fromUserId, toUserId])
  @@index([toUserId, decision])
  @@index([fromUserId, undoneAt, createdAt])
}

model UnionIntention {
  id        String             @id @default(uuid())
  profileId String
  profile   UnionProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type      UnionIntentionType
  // 0..100, сумма по профилю = 100 (валидируется в сервисе)
  weight    Int

  @@unique([profileId, type])
}

model UnionConnectionRequest {
  id          String                @id @default(uuid())
  fromUserId  String
  fromUser    User                  @relation("UnionRequestsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User                  @relation("UnionRequestsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  status      UnionConnectionStatus @default(pending)
  /// Заявка отправлена суперлайком: поднимается в списке входящих.
  isSuperlike Boolean               @default(false)
  message     String?
  createdAt   DateTime              @default(now())
  respondedAt DateTime?

  messages UnionChatMessage[]

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
}

enum UserReportReason {
  spam
  harassment
  fake_profile
  inappropriate_content
  offline_safety
  other
}

enum UserReportStatus {
  open
  reviewed
  dismissed
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("UserBlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model UserReport {
  id            String           @id @default(uuid())
  reporterId    String
  reporter      User             @relation("UserReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  targetId      String
  target        User             @relation("UserReportsReceived", fields: [targetId], references: [id], onDelete: Cascade)
  reason        UserReportReason
  comment       String?
  status        UserReportStatus @default(open)
  createdAt     DateTime         @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?            @relation("UserReportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  moderatorNote String?

  @@index([status, createdAt])
  @@index([targetId])
}

/// Обращение в поддержку. userId пуст у гостевых тикетов с лендинга — связь
/// с автором держится на contactEmail/contactTelegram и trackToken.
model SupportTicket {
  id              String                @id @default(uuid())
  number          Int                   @unique @default(autoincrement())
  /// Секретная ссылка для гостя: единственный способ посмотреть свой тикет без входа.
  trackToken      String                @unique
  userId          String?
  user            User?                 @relation("SupportTicketsOwned", fields: [userId], references: [id], onDelete: SetNull)
  contactName     String?
  contactEmail    String?
  contactTelegram String?
  subject         String
  category        SupportTicketCategory @default(other)
  status          SupportTicketStatus   @default(open)
  assignedToId    String?
  assignedTo      User?                 @relation("SupportTicketsAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)
  adminNote       String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  firstResponseAt DateTime?
  closedAt        DateTime?
  lastMessageAt   DateTime              @default(now())

  messages SupportTicketMessage[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model SupportTicketMessage {
  id           String              @id @default(uuid())
  ticketId     String
  ticket       SupportTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType   SupportTicketAuthor
  authorUserId String?
  authorUser   User?               @relation("SupportTicketMessagesAuthored", fields: [authorUserId], references: [id], onDelete: SetNull)
  body         String
  /// Внутренняя заметка видна только администраторам.
  isInternal   Boolean             @default(false)
  createdAt    DateTime            @default(now())

  @@index([ticketId, createdAt])
}

model UnionChatMessage {
  id         String                 @id @default(uuid())
  requestId  String
  request    UnionConnectionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User                   @relation("UnionChatMessagesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  body       String
  /// Когда собеседник прочитал сообщение; null — ещё не прочитано.
  readAt     DateTime?
  /// Когда сообщение было отредактировано; null — не редактировалось.
  editedAt   DateTime?
  createdAt  DateTime               @default(now())
  reactions  UnionMessageReaction[]

  @@index([requestId, createdAt])
  @@index([fromUserId])
  @@index([requestId, readAt])
}

/// Реакция на сообщение чата. Одна реакция на пользователя на сообщение —
/// повторный выбор того же эмодзи снимает реакцию, другого — заменяет.
model UnionMessageReaction {
  id        String           @id @default(uuid())
  messageId String
  message   UnionChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation("UnionMessageReactionsMade", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime         @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
}

// ===== Library service =====

enum LibraryEntryType {
  website
  article
  video
  audio
  book
  course
  app
  telegram_channel
  community
  other
}

enum LibraryEntryStatus {
  published
  hidden_by_reports
  removed_by_admin
}

enum LibraryEnrichmentStatus {
  pending
  queued
  ready
  failed
}

enum LibraryCategoryStatus {
  active
  hidden_by_reports
  merged
  removed
}

model LibrarySection {
  id            String   @id @default(uuid())
  slug          String   @unique
  titleRu       String
  titleEn       String
  descriptionRu String?
  descriptionEn String?
  iconKey       String?
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categories LibraryCategory[]

  @@index([position])
}

model LibraryCategory {
  id               String                @id @default(uuid())
  sectionId        String
  section          LibrarySection        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  slug             String
  titleRu          String?
  titleEn          String?
  descriptionRu    String?
  descriptionEn    String?
  normalizedRu     String                @default("")
  normalizedEn     String                @default("")
  createdById      String?
  createdBy        User?                 @relation("LibraryCategoryAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  status           LibraryCategoryStatus @default(active)
  mergedIntoId     String?
  mergedInto       LibraryCategory?      @relation("LibraryCategoryMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom       LibraryCategory[]     @relation("LibraryCategoryMerge")
  entriesCount     Int                   @default(0)
  followersCount   Int                   @default(0)
  openReportsCount Int                   @default(0)
  needsReview      Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  entries LibraryEntryCategory[]

  @@unique([sectionId, slug])
  @@index([sectionId, status])
  @@index([status, entriesCount])
}

model LibraryEntry {
  id               String                   @id @default(uuid())
  url              String
  urlNormalized    String                   @unique
  canonicalUrl     String?
  domain           String
  type             LibraryEntryType
  contentLanguage  String                   @default("ru") @db.VarChar(8)
  titleRu          String?
  titleEn          String?
  descriptionRu    String?
  descriptionEn    String?
  ogTitle          String?
  ogDescription    String?
  ogSiteName       String?
  faviconUrl       String?
  previewKey       String?
  previewUrl       String?
  enrichmentStatus LibraryEnrichmentStatus  @default(pending)
  enrichmentError  String?
  enrichedAt       DateTime?
  httpStatus       Int?
  lastCheckedAt    DateTime?
  addedById        String?
  addedBy          User?                    @relation("LibraryEntryAuthor", fields: [addedById], references: [id], onDelete: SetNull)
  status           LibraryEntryStatus       @default(published)
  needsReview      Boolean                  @default(false)
  usefulCount      Int                      @default(0)
  notUsefulCount   Int                      @default(0)
  uniqueClickCount Int                      @default(0)
  bookmarkCount    Int                      @default(0)
  commentsCount    Int                      @default(0)
  openReportsCount Int                      @default(0)
  rankScore        Float                    @default(0)
  /// Generated column, создаётся SQL-миграцией. Prisma её не пишет.
  searchVector     Unsupported("tsvector")?
  publishedAt      DateTime                 @default(now())
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  categories LibraryEntryCategory[]
  bookmarks  LibraryBookmark[]
  comments   LibraryComment[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([status, rankScore(sort: Desc)])
  @@index([type])
  @@index([contentLanguage])
  @@index([domain])
  @@index([addedById])
}

model LibraryEntryCategory {
  entryId    String
  entry      LibraryEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  categoryId String
  category   LibraryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  addedById  String?
  createdAt  DateTime        @default(now())

  @@id([entryId, categoryId])
  @@index([categoryId])
}

/// Избранное: у пары «пользователь + ссылка» запись одна, счётчик на
/// LibraryEntry.bookmarkCount держим денормализованным для ленты.
model LibraryBookmark {
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryId   String
  entry     LibraryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@id([userId, entryId])
  @@index([entryId])
  @@index([userId, createdAt(sort: Desc)])
}

enum LibraryCommentStatus {
  published
  removed_by_author
  removed_by_admin
}

/// Комментарии под ссылкой. Плоские: ветки в библиотеке ссылок избыточны,
/// а удалённые оставляем строкой со статусом, чтобы не рвать нумерацию.
model LibraryComment {
  id        String               @id @default(uuid())
  entryId   String
  entry     LibraryEntry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  body      String
  status    LibraryCommentStatus @default(published)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([entryId, createdAt])
  @@index([userId])
}

model LibraryPreference {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  uiLanguage       String   @default("ru") @db.VarChar(8)
  contentLanguages String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ===== Notifications (портальная инфраструктура) =====

/// Подписка браузера на веб-пуши. У одного пользователя их несколько:
/// телефон, ноутбук, планшет. Ключ подписки — endpoint, его выдаёт браузер.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Настройки уведомлений. Отсутствие строки означает «включено всё»,
/// поэтому при регистрации её создавать не нужно.
model NotificationPreference {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(true)
  chat        Boolean  @default(true)
  connections Boolean  @default(true)
  support     Boolean  @default(true)
  /// Ежедневный персональный день по транзитам (сервис astro).
  transits    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// ===== Astro service =====

/// Насколько точно известно время рождения. `unknown` — карта считается на полдень,
/// а лагна и дома не показываются: асцендент по выдуманному времени хуже, чем его
/// отсутствие.
enum AstroTimeAccuracy {
  exact
  approximate
  unknown
}

/// Данные рождения. Отдельно от `User`: у портала есть только дата, а карте нужны
/// ещё время, место и часовой пояс.
model AstroBirthData {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Момент рождения в UTC — единственный источник истины для расчёта карты.
  bornAtUtc      DateTime
  /// Дата и время так, как их ввёл человек, по месту рождения. Хранятся отдельно,
  /// чтобы показать их обратно без обратного пересчёта и чтобы правка часового
  /// пояса не требовала догадываться, что было введено изначально.
  birthDateLocal DateTime          @db.Date
  birthTimeLocal String?
  timeAccuracy   AstroTimeAccuracy @default(exact)

  placeLabel String
  latitude   Float
  longitude  Float
  /// Идентификатор зоны IANA. Определяется по координатам, но может быть
  /// переопределён вручную для приграничных мест.
  timezone   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Раздел ИИ-разбора карты.
enum AstroSection {
  overview
  lagna
  moon_nakshatra
  dasha_current
  career
  relationships
  strengths
  practice
}

/// Интерпретация раздела. Ключуется отпечатком карты, а не пользователем: карта
/// детерминирована, поэтому таблицу самих карт держать не нужно, а текст про
/// одинаковые карты одинаков (у близнецов кэш общий — это верно по существу).
/// Версия промпта входит в ключ: правка промпта инвалидирует кэш без миграций.
model AstroReading {
  id               String       @id @default(uuid())
  chartFingerprint String
  section          AstroSection
  locale           String
  promptVersion    String
  text             String
  model            String
  tokensIn         Int
  tokensOut        Int
  createdAt        DateTime     @default(now())

  @@unique([chartFingerprint, section, locale, promptVersion])
}

/// Расход пользователя за сутки. Ключ по дню — сброс квоты не требует джоба.
model AstroUsage {
  userId    String
  day       DateTime @db.Date
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readings  Int      @default(0)
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)

  @@id([userId, day])
}

/// Расход всего сервиса за сутки. `haltedAt` не null — сработал kill-switch.
model AstroBudgetDay {
  day          DateTime  @id @db.Date
  tokensIn     Int       @default(0)
  tokensOut    Int       @default(0)
  costUsdCents Int       @default(0)
  haltedAt     DateTime?
}

/// Единственная строка настроек сервиса (id всегда "global"). Правится из админки,
/// чтобы менять лимиты без передеплоя.
model AstroSettings {
  id                     String   @id @default("global")
  enabled                Boolean  @default(true)
  /// Аварийный выключатель ИИ: карта считается и показывается, тексты — только из кэша.
  aiEnabled              Boolean  @default(true)
  dailyReadingsPerUser   Int      @default(3)
  dailyTokensPerUser     Int      @default(20000)
  dailyTokenBudget       Int      @default(2000000)
  dailyCostLimitUsdCents Int      @default(1000)
  transitPushEnabled     Boolean  @default(true)
  updatedAt              DateTime @updatedAt
}

/// Статус запроса на сопоставление карт. Согласие — свой процесс внутри astro,
/// не зависящий от статуса анкет в Union: инициатор может быть кем угодно из
/// пользователей портала, а не только участником взаимного мэтча.
enum AstroCompatibilityStatus {
  pending
  accepted
  declined
}

/// Запрос на сопоставление карт двух пользователей. Обе карты закрыты, пока
/// получатель не примет запрос явно — точка входа из Union передаёт только id
/// человека, дальнейшее согласие целиком в astro.
model AstroCompatibilityRequest {
  id          String                   @id @default(uuid())
  requesterId String
  requester   User                     @relation("AstroCompatibilityRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetId    String
  target      User                     @relation("AstroCompatibilityTarget", fields: [targetId], references: [id], onDelete: Cascade)
  status      AstroCompatibilityStatus @default(pending)
  createdAt   DateTime                 @default(now())
  respondedAt DateTime?

  @@unique([requesterId, targetId])
  @@index([targetId, status])
}

/// ИИ-разбор сопоставления. Ключ — отсортированная пара отпечатков карт, поэтому
/// не важно, кто из двоих инициатор: разбор одной и той же пары карт один.
model AstroCompatibilityReading {
  id            String   @id @default(uuid())
  /// `${меньший отпечаток}:${больший отпечаток}` — сортировка убирает направление.
  pairKey       String
  locale        String
  promptVersion String
  text          String
  model         String
  tokensIn      Int
  tokensOut     Int
  createdAt     DateTime @default(now())

  @@unique([pairKey, locale, promptVersion])
}

/// Дневной дайджест транзитов пользователя. Данные — детерминированный расчёт,
/// хранятся всегда; текст и pushedAt заполняются только если дошло до отправки.
model AstroTransitDigest {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  forDate   DateTime  @db.Date
  data      Json
  text      String?
  pushedAt  DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, forDate])
}

/// Готовая фраза под транзитный паттерн, общая на весь портал. Ключевая
/// экономия дня: паттерн — это бхава транзитной Луны относительно лагны
/// человека (1..12), а не сам человек, поэтому вариантов конечное малое число
/// независимо от размера базы пользователей.
model AstroTransitPhrase {
  id            String   @id @default(uuid())
  patternKey    String
  locale        String
  promptVersion String
  text          String
  createdAt     DateTime @default(now())

  @@unique([patternKey, locale, promptVersion])
}
