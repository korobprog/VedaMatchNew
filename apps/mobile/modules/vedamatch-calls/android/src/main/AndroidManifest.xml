<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Self-managed ConnectionService (VED-221, docs/mobile-calls-native.md §3):
         BIND_TELECOM_CONNECTION_SERVICE обязателен для системы, чтобы отдать
         управление звонком только Telecom, а не любому вызывающему. -->
    <service
      android:name="com.vedamatch.calls.VedamatchConnectionService"
      android:exported="true"
      android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
      <intent-filter>
        <action android:name="android.telecom.ConnectionService" />
      </intent-filter>
    </service>

    <!-- Headless JS задача «отклонить из фона» (п.4 спеки) — тот же
         механизм, которым @react-native-firebase/messaging уже поднимает
         фоновый обработчик пуша (ReactNativeFirebaseMessagingHeadlessService),
         свой сервис нужен, чтобы стартовать задачу по нажатию на действие
         уведомления, а не только по FCM. -->
    <service
      android:name="com.vedamatch.calls.DeclineHeadlessTaskService"
      android:exported="false" />

    <!-- Headless JS задача «завершить» из onTaskRemoved (VED-222, п.1 —
         исправление feedback-001.md этого этапа, блокирующий п.2): тот же
         механизм, что DeclineHeadlessTaskService выше, только для случая
         «приложение смахнули из списка последних задач во время разговора» —
         CallForegroundService.onTaskRemoved() не может полагаться на живой
         JS-мост, HTTP-запрос серверу должен уйти из собственного сервиса
         с wake lock. -->
    <service
      android:name="com.vedamatch.calls.HangupHeadlessTaskService"
      android:exported="false" />

    <!-- Служба «Идёт звонок» на время разговора (VED-222,
         docs/mobile-calls-native.md §12). Android 14 (API 34) требует
         объявить в манифесте каждый foregroundServiceType, который сервис
         передаст в startForeground(id, notification, type) в рантайме —
         здесь объявлены все три (аудиозвонок использует phoneCall и
         microphone, видео добавляет camera), а конкретный вызов выбирает
         подмножество по типу звонка (CallForegroundService.kt). -->
    <service
      android:name="com.vedamatch.calls.CallForegroundService"
      android:exported="false"
      android:foregroundServiceType="phoneCall|microphone|camera" />

    <receiver
      android:name="com.vedamatch.calls.CallActionReceiver"
      android:exported="false" />
  </application>
</manifest>
