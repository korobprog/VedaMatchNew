# PostgreSQL
POSTGRES_USER=vedamatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vedamatch
DATABASE_URL=postgresql://vedamatch:change-me@localhost:5432/vedamatch
# Импорт старой базы Vedabase (packages/gitabase-importer, migrate-legacy.ts):
# источник для разового переноса; в рантайме API не используется.
LEGACY_DATABASE_URL=

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Base URL по которому доступен api снаружи (для OAuth redirect_uri)
API_PUBLIC_URL=http://localhost:4000
COOKIE_DOMAIN=
# Публичный адрес сайта — подставляется в ссылки внутри iCal-экспорта объявлений
# (GET /notices/.../ics). По умолчанию https://vedamatch.ru.
WEB_PUBLIC_URL=http://localhost:3000

# Docker-entrypoint API (apps/api/docker-entrypoint.sh): при старте контейнера
# выполняется `prisma migrate deploy`, затем `prisma db seed`. SEED_ON_START=0
# отключает сид (например, чтобы не трогать справочники на проде при рестарте).
SEED_ON_START=1
# Сид по умолчанию не перезаписывает поля, которые правит админ (названия,
# иконки, позиции разделов). SEED_REFRESH_ADMIN_EDITABLE=1 — освежить их из файлов данных.
SEED_REFRESH_ADMIN_EDITABLE=0

# Vedabase/Gitabase. Кэш загрузок импортёра (packages/gitabase-importer).
# Права на источник (permission-ref/attribution) передаются импортёру CLI-флагами.
VEDABASE_CACHE_DIR=.vedabase-cache
# Каталог со снапшотами Gitabase-контента, который читает API
# (GitabaseContentService). По умолчанию /var/lib/vedamatch/gitabase.
GITABASE_CONTENT_DIR=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT: RS256 приватный ключ в PKCS8 PEM, base64-encoded одной строкой.
# Сгенерировать: node apps/api/scripts/generate-keys.mjs
JWT_PRIVATE_KEY_BASE64=
# TTL access-токена в формате jose ("15m", "1h"), refresh — в днях.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Dev-вход по логину и паролю. Работает только при NODE_ENV != production.
# Демо-аккаунты создаёт `pnpm --filter @vedamatch/api seed:dev`.
DEV_AUTH_ENABLED=false
NEXT_PUBLIC_DEV_AUTH=false
DEMO_PASSWORD=vedamatch

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
# Абсолютный адрес сайта для og:image/metadataBase (apps/web/src/app/layout.tsx).
# По умолчанию https://vedamatch.ru.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Redis — фоновые воркеры (Motivation, Notices, Astro-транзиты) и их локи.
# Без REDIS_HOST воркеры не стартуют, остальной API работает как обычно.
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Profile avatar storage (S3/S3-compatible)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=
USER_GALLERY_QUOTA_MB=250

# Optional custom User-Agent for OpenStreetMap Nominatim requests
NOMINATIM_USER_AGENT=VedaMatch/1.0 (profile geo search)

# Motivation: OpenAI-compatible провайдер для генерации текста и изображений.
# Ключ создаётся на https://relay.fast/keys, каталог моделей и цены — на
# https://relay.fast/pricing. Без ключа генерация в Motivation недоступна
# (админ-панель вернёт 503 "Motivation AI is not configured"), остальной
# сервис работает как обычно.
MOTIVATION_AI_BASE_URL=https://relay.fast/v1
MOTIVATION_AI_API_KEY=
# Модель для текста квот/постов (chat/completions). gpt-5.4-mini — самая
# дешёвая из проверенных рабочих моделей. claude-haiku-4-5 и gpt-5.6-sol тоже
# рабочие, но дороже. gpt-5.6-luna не используй — у неё воспроизводимо
# зависают запросы дольше 60с, несмотря на то что должна быть ещё дешевле.
MOTIVATION_TEXT_MODEL=gpt-5.4-mini
# Модель для картинок (POST /images/generations, стандартный OpenAI Images API).
MOTIVATION_IMAGE_MODEL=gpt-image-2
MOTIVATION_IMAGE_TIMEOUT_MS=180000
# Сколько кандидатов-цитат воркер готовит на день (по умолчанию 8).
MOTIVATION_DAILY_CANDIDATE_COUNT=8
# Разрешённые домены-источники цитат через запятую. Пусто — встроенный список
# (vedabase.io, vedabase.com, prabhupadabooks.com, wikiquote.org).
MOTIVATION_APPROVED_SOURCE_DOMAINS=

# Astro: тот же OpenAI-совместимый провайдер, для ИИ-разборов карты
# (overview/lagna/etc). Без ключа расчёт карты работает как обычно, но
# разборы возвращают 503 "Astro AI не настроен".
ASTRO_AI_BASE_URL=https://relay.fast/v1
ASTRO_AI_API_KEY=
# deepseek-v4-flash недоступна на relay.fast для этого ключа (404
# model_not_available) — используй проверенную модель Motivation.
ASTRO_TEXT_MODEL=gpt-5.4-mini
# Цена модели в центах USD за 1M токенов (вход/выход) — для учёта расхода и
# дневного лимита в админке Astro. 0 — учёт стоимости выключен.
ASTRO_AI_USD_CENTS_PER_MTOK_IN=0
ASTRO_AI_USD_CENTS_PER_MTOK_OUT=0

# Веб-пуши. Ключи генерируются один раз: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@vedamatch.ru
