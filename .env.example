# PostgreSQL
POSTGRES_USER=vedamatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vedamatch
DATABASE_URL=postgresql://vedamatch:change-me@localhost:5432/vedamatch

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Base URL по которому доступен api снаружи (для OAuth redirect_uri)
API_PUBLIC_URL=http://localhost:4000
COOKIE_DOMAIN=
# Import-only metadata. Supply exact approved values; never invent or infer them.
VEDABASE_SOURCE_PERMISSION_REF=
VEDABASE_SOURCE_ATTRIBUTION=
VEDABASE_CACHE_DIR=.vedabase-cache

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT: RS256 приватный ключ в PKCS8 PEM, base64-encoded одной строкой.
# Сгенерировать: node apps/api/scripts/generate-keys.mjs
JWT_PRIVATE_KEY_BASE64=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Dev-вход по логину и паролю. Работает только при NODE_ENV != production.
# Демо-аккаунты создаёт `pnpm --filter @vedamatch/api seed:dev`.
DEV_AUTH_ENABLED=false
NEXT_PUBLIC_DEV_AUTH=false
DEMO_PASSWORD=vedamatch

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000

# Profile avatar storage (S3/S3-compatible)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=
USER_GALLERY_QUOTA_MB=250

# Optional custom User-Agent for OpenStreetMap Nominatim requests
NOMINATIM_USER_AGENT=VedaMatch/1.0 (profile geo search)

# Motivation: OpenAI-compatible провайдер для генерации текста и изображений.
# Ключ создаётся на https://relay.fast/keys, каталог моделей и цены — на
# https://relay.fast/pricing. Без ключа генерация в Motivation недоступна
# (админ-панель вернёт 503 "Motivation AI is not configured"), остальной
# сервис работает как обычно.
MOTIVATION_AI_BASE_URL=https://relay.fast/v1
MOTIVATION_AI_API_KEY=
# Модель для текста квот/постов (chat/completions). gpt-5.4-mini — самая
# дешёвая из проверенных рабочих моделей. claude-haiku-4-5 и gpt-5.6-sol тоже
# рабочие, но дороже. gpt-5.6-luna не используй — у неё воспроизводимо
# зависают запросы дольше 60с, несмотря на то что должна быть ещё дешевле.
MOTIVATION_TEXT_MODEL=gpt-5.4-mini
# Модель для картинок (POST /images/generations, стандартный OpenAI Images API).
MOTIVATION_IMAGE_MODEL=gpt-image-2
MOTIVATION_IMAGE_TIMEOUT_MS=180000

# Оживление иллюстрации поста в ролик (fal.ai). Без FAL_KEY стадия видео
# просто не запускается — остальной пайплайн Мотивации работает как прежде.
FAL_KEY=
# Pro Fast вместо Pro: та же модель, тариф $1.0 за миллион видео-токенов
# против $2.5. Замерено — ролик 5 с 720p стоит ~$0.10 вместо ~$0.26.
MOTIVATION_VIDEO_MODEL=fal-ai/bytedance/seedance/v1/pro/fast/image-to-video
# Длина ролика в секундах: цена у провайдера линейна по ней.
MOTIVATION_VIDEO_DURATION=5
# Нативный звук удваивает стоимость токенов; подпись и музыку накладываем сами.
MOTIVATION_VIDEO_AUDIO=false
# Озвучка цитаты. Читает наш проверенный текст, а не сочиняет звук, как это
# делает видеомодель. ~$0.10 за 1000 знаков, то есть меньше двух центов за пост.
MOTIVATION_VOICE_MODEL=fal-ai/elevenlabs/tts/multilingual-v2
MOTIVATION_VOICE_NAME=Rachel
# Путь к ffmpeg. В образе он на PATH и переменная не нужна; на Windows
# укажите полный путь, если бинарь не в PATH.
FFMPEG_PATH=
# Общий дневной потолок расхода на генерацию, в долларах. Персональные лимиты
# ограничивают одного человека, но не сумму — без этого потолка бюджет не защищён.
MOTIVATION_AI_DAILY_BUDGET_USD=5

# Astro: тот же OpenAI-совместимый провайдер, для ИИ-разборов карты
# (overview/lagna/etc). Без ключа расчёт карты работает как обычно, но
# разборы возвращают 503 "Astro AI не настроен".
ASTRO_AI_BASE_URL=https://relay.fast/v1
ASTRO_AI_API_KEY=
# deepseek-v4-flash недоступна на relay.fast для этого ключа (404
# model_not_available) — используй проверенную модель Motivation.
ASTRO_TEXT_MODEL=gpt-5.4-mini

# Веб-пуши. Ключи генерируются один раз: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@vedamatch.ru
