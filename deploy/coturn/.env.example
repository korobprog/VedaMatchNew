# Общий секрет с API (TURN_SECRET там же). openssl rand -hex 32
TURN_SECRET=
TURN_REALM=vedamatch.ru
# Публичный адрес сервера: coturn за NAT не стоит, но explicit лучше guess.
TURN_EXTERNAL_IP=
