# Общий секрет с API (TURN_SECRET там же). openssl rand -hex 32
TURN_SECRET=
TURN_REALM=vedamatch.ru
# Хост за 1:1 NAT: «внешний/внутренний», иначе в relay-кандидатах будет 192.168.*
TURN_EXTERNAL_IP=64.130.62.129/192.168.195.2
# 443 занят Traefik'ом; 5349 — пока не появится отдельный IP (README).
TURN_TLS_PORT=5349
# Папка с fullchain.pem и privkey.pem для turn.vedamatch.ru
TURN_CERT_DIR=./certs
