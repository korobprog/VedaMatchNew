# Раздача файлов портала со своего домена (media.vedamatch.ru) поверх
# хранилища FirstVDS.
#
# Зачем: сертификат firsts3.ru выдан от корня GlobalSign Root R46, которого
# нет в хранилище доверия старых Android (проверено на Android 12, Realme
# RMX2155: «Trust anchor for certification path not found»). Картинки,
# аудио и манифест самообновления в приложении и в браузере таких телефонов
# не открывались. Наш домен отдаёт сертификат Traefik, которому доверяют
# все, а хранилище остаётся тем же.
#
# Шаблон разворачивает entrypoint образа nginx (envsubst по переменным
# окружения контейнера): S3_BUCKET_NAME, S3_UPSTREAM и S3_UPSTREAM_HOST
# задаёт compose.

# Резолвер докера: имя хранилища разрешается на каждый запрос (с кэшем), а
# не один раз при старте — nginx не упадёт при старте без DNS и переживёт
# смену адреса у провайдера.
resolver 127.0.0.11 valid=300s ipv6=off;

server {
  listen 80;
  server_name _;

  location = /healthz {
    access_log off;
    return 200 "ok\n";
  }

  # Только наш бакет: иначе прокси стал бы открытым шлюзом к чужим бакетам
  # того же провайдера с нашего домена.
  location /${S3_BUCKET_NAME}/ {
    set $s3_upstream ${S3_UPSTREAM};

    # Подписанные ссылки (X-Amz-Signature) подписаны на хост хранилища:
    # путь и query уходят как есть, Host — хранилища, и подпись сходится.
    proxy_pass $s3_upstream;
    proxy_set_header Host ${S3_UPSTREAM_HOST};
    proxy_ssl_server_name on;
    proxy_ssl_name ${S3_UPSTREAM_HOST};
    proxy_http_version 1.1;
    proxy_set_header Connection "";

    # Cookie портала ставятся на .vedamatch.ru и долетели бы сюда — к
    # провайдеру они уходить не должны.
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Real-IP "";

    # Аудио с перемоткой (Range), APK на 100 МБ и загрузки по подписанным
    # PUT: без буферизации и без лимита на тело.
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  location / {
    return 404;
  }
}
